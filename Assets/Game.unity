    \u06A9\u0627\u0645\u0644\u0627 \u0645\u062D\u062F\u0628 \u0627\u0633\u062A.\r\n\u2022
    \u0631\u0627\u0633 \u06A9\u0627\u0633\u067E \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644
    \u0628\u0647 \u0646\u062D\u0648\u06CC \u0628\u0627\u0631\u0632\u06CC \u0627\u0646\u062D\u0631\u0641
    \u0645\u0632\u06CC\u0627\u0644\u06CC \u062F\u0627\u0631\u062F.\r\n\u2022 H.OFC
    \u0633\u0637\u062D \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644 \u062F\u0631 1/3
    \u0648\u0633\u0637 \u0642\u0631\u0627\u0631 \u062F\u0627\u0631\u062F.\r\n\u0646\u0645\u0627\u06CC
    \u0645\u0632\u06CC\u0627\u0644\r\n\u2022 \u0634\u06A9\u0644 \u0647\u0646\u062F\u0633\u06CC
    \u0627\u06CC\u0646 \u0633\u0637\u062D \u0630\u0648\u0632\u0646\u0642\u0647 \u0627\u0633\u062A
