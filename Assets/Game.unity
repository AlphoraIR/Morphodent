--- !u!114 &1371985517
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 1371985515}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 02c187b07e47c5a41a6f2ab699b6cdd5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  teethName: 1 - (R) Third Molar
  teethBio: "\u2022 \u0647\u0634\u062A\u0645\u06CC\u0646 \u0648 \u0622\u062E\u0631\u06CC\u0646
    \u062F\u0646\u062F\u0627\u0646 \u0627\u0632 \u062E\u0637 \u0648\u0633\u0637 \u0627\u0633\u062A
    \u0648 \u0641\u0642\u0637 \u062F\u0627\u0631\u0627\u06CC \u062A\u0645\u0627\u0633
    \u0645\u0632\u06CC\u0627\u0644 \u0628\u0627 \u0645\u0648\u0644\u0631 \u062F\u0648\u0645
    \u0627\u0633\u062A \u0648 \u062A\u0645\u0627\u0633 \u062F\u06CC\u0633\u062A\u0627\u0644
    \u0646\u062F\u0627\u0631\u062F.\r\n\u2022 \u0628\u0647 \u0639\u0646\u0648\u0627\u0646
    \u062F\u0646\u062F\u0627\u0646 \u062C\u0627\u0646\u0634\u06CC\u0646 \u0628\u0647
    \u062D\u0633\u0627\u0628 \u0646\u0645\u06CC \u0622\u06CC\u062F.\r\n\u2022 \u062F\u0631\u0633\u06CC\u0633\u062A\u0645
    \u062C\u0647\u0627\u0646\u06CC \u0645\u0648\u0644\u0631 \u0633\u0648\u0645 \u0631\u0627\u0633\u062A
    \u0628\u0627\u0644\u0627 \u0628\u0627 \u0634\u0645\u0627\u0631\u0647 1 \u0648
    \u062F\u0631 \u0633\u06CC\u0633\u062A\u0645 F.D.I \u0628\u0647 \u0634\u0645\u0627\u0631\u0647
    18 \u0645\u0634\u062E\u0635 \u0645\u06CC \u0634\u0648\u062F.\r\n\u2022 \u0627\u06CC\u0646
    \u062F\u0646\u062F\u0627\u0646  \u062A\u06A9\u0645\u06CC\u0644 \u06A9\u0646\u0646\u062F\u0647
    \u0641\u0646\u06A9\u0634\u0646 \u0645\u0648\u0644\u0631 \u0647\u0627\u06CC \u0627\u0648\u0644
    \u0648 \u062F\u0648\u0645 \u0627\u0633\u062A.\r\n\u2022 \u062A\u0627\u062C \u062F\u0631
    \u0627\u0628\u0639\u0627\u062F \u06A9\u0644\u06CC \u062E\u0648\u062F \u06A9\u0648\u0686\u06A9\u062A\u0631
    \u0627\u0632 \u0645\u0648\u0644\u0631 \u062F\u0648\u0645 \u0627\u0633\u062A \u0648
    \u062F\u0631 \u062A\u0645\u0627\u0645 \u0627\u0628\u0639\u0627\u062F \u06AF\u0631\u062F\u0634\u062F\u06AF\u06CC
    \u062F\u06CC\u062F\u0647 \u0645\u06CC\u0634\u0648\u062F.\r\n\u2022 \u0631\u06CC\u0634\u0647
    \u0647\u0627 \u06A9\u0648\u062A\u0627\u0647 \u062A\u0631 \u0627\u0632 \u0645\u0648\u0644\u0631
    \u062F\u0648\u0645 \u0627\u0633\u062A \u0648 \u0627\u063A\u0644\u0628 \u0628\u0647
    \u0647\u0645 \u0686\u0633\u0628\u06CC\u062F\u0647 \u0627\u0633\u062A.\r\n\u2022
    \u0645\u0648\u0644\u0631 \u0633\u0648\u0645 \u0627\u0632 \u0646\u0638\u0631 \u0627\u0646\u062F\u0627\u0632\u0647\u060C
    \u0634\u06A9\u0644 \u06A9\u0627\u0646\u062A\u0648\u0631\u0648 \u0633\u0627\u06CC\u0631
    \u0627\u062E\u062A\u0635\u0627\u0635\u0627\u062A \u0645\u062A\u063A\u06CC\u0631
    \u062A\u0631\u06CC\u0646 \u062F\u0646\u062F\u0627\u0646 \u0641\u06A9 \u0628\u0627\u0644\u0627
    \u0627\u0633\u062A.\r\n\u2022 \u0641\u0631\u0645 \u0642\u0644\u0628\u06CC \u0633\u0637\u062D
    \u0627\u06A9\u0644\u0648\u0632\u0627\u0644 \u0634\u0627\u06CC\u0639 \u062A\u0631\u06CC\u0646
    \u0646\u0648\u0639 \u0627\u06CC\u0646 \u062F\u0646\u062F\u0627\u0646 \u0627\u0633\u062A.\r\n\u2022
    \u062F\u0631 \u0641\u0631\u0645 \u0642\u0644\u0628\u06CC 3 \u06A9\u0627\u0633\u067E
    \u062F\u06CC\u062F\u0647 \u0645\u06CC\u0634\u0648\u062F \u06A9\u0627\u0633\u067E
    \u0645\u0632\u06CC\u0648 \u0628\u0627\u06A9\u0627\u0644\u060C \u06A9\u0627\u0633\u067E
    \u062F\u06CC\u0633\u062A\u0648 \u0628\u0627\u06A9\u0627\u0644 \u0648 \u06A9\u0627\u0633\u067E
    \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644.\r\n\u2022 \u0645\u0648\u0644\u0631
    \u0633\u0648\u0645 \u0645\u0639\u0645\u0648\u0644\u0627 \u062F\u0631 \u062C\u0647\u062A
    \u0628\u0627\u06A9\u0648 \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644 \u067E\u0647\u0646
    \u062A\u0631 \u0627\u0632 \u0645\u0632\u06CC\u0648 \u062F\u06CC\u0633\u062A\u0627\u0644
    \u0627\u0633\u062A.\r\n"
