  m_Name: 
  m_EditorClassIdentifier: 
  teethName: 21 - (L) First Premolar
  teethBio: "\u2022 \u067E\u0631\u0645\u0648\u0644\u0631\u0647\u0627\u06CC \u067E\u0627\u06CC\u06CC\u0646
    \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u062F\u0627\u0631\u0627\u06CC \u0628\u06CC\u0634
    \u0627\u0632 \u062F\u0648 \u06A9\u0627\u0633\u067E \u0628\u0627\u0634\u0646\u062F.\r\n\u2022
    \u06A9\u0627\u0633\u067E \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644 \u0622\u0646\u0647\u0627
    \u06A9\u0645\u062A\u0631 \u0627\u0632 \u06A9\u0627\u0633\u067E \u0628\u0627\u06A9\u0627\u0644
    \u0628\u0631\u062C\u0633\u062A\u0647 \u0627\u0633\u062A.\r\n\u2022 \u0627\u0632
    \u062F\u06CC\u062F \u067E\u0631\u0648\u06A9\u0632\u06CC\u0645\u0627\u0644 \u062A\u0627\u062C
    \u0622\u0646\u0647\u0627 \u062A\u0645\u0627\u06CC\u0644 \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644\u06CC
    \u0634\u062F\u06CC\u062F \u062F\u0627\u0631\u062F.\r\n\u2022 \u0639\u0631\u0636
    \u0628\u0627\u06A9\u0648\u0644\u06CC\u0646\u06AF\u0648\u0627\u0644 \u0648 \u0645\u0632\u06CC\u0648\u062F\u06CC\u0633\u062A\u0627\u0644
