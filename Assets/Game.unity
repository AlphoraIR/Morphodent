    \uFEED\uFEB3\uFEC2 \uFE8D\uFEB3\uFE96 \uFB90\uFEEA \uFE9F\uFE8E\uFEE7\uFEB8\uFBFF\uFEE6
    \uFB90\uFE8E\uFEE7\uFBFF\uFEE6 \uFEB7\uFBFF\uFEAE\uFBFC \uFEE3\uFBFF\uFEB8\uFEEE\uFEA9
    \uFEED \uFEA9\uFE8D\uFEAD\uFE8D\uFBFC \uFE97\uFEE4\uFE8E\uFEB1 \uFEE3\uFEB0\uFBFE\uFE8E\uFEDD
    \uFE91\uFE8E \uFEA9\uFEE7\uFEAA\uFE8D\uFEE5 \uFEA9\uFBFE\uFEB4\uFE98\uFE8E\uFEDD
