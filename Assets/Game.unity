--- !u!114 &1025035289
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 1025035287}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 02c187b07e47c5a41a6f2ab699b6cdd5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  teethName: 8 - (R) Central Incisor
  teethBio: "\u062F\u0646\u062F\u0627\u0646 \u0627\u06CC\u0646\u0633\u06CC\u0632\u0648\u0631
    \u0633\u0646\u062A\u0631\u0627\u0644 \u0645\u0627\u06AF\u0632\u06CC\u0644\u0627
    \u062F\u0631 \u0646\u06CC\u0645 \u0641\u06A9 \u0631\u0627\u0633\u062A \u06A9\u0647
    \u0634\u0645\u0627\u0631\u0647 \u0622\u0646 \u062F\u0631 \u0633\u06CC\u0633\u062A\u0645
    \u062C\u0647\u0627\u0646\u06CC 8 \u0648 \u062F\u0631 \u0633\u06CC\u0633\u062A\u0645
    F.D.I  \u0628\u0627 \u0634\u0645\u0627\u0631\u0647 11 \u0646\u0634\u0627\u0646
    \u062F\u0627\u062F\u0647 \u0645\u06CC \u0634\u0648\u062F.\r\n\u2022 \u0628\u0632\u0631\u06AF\u062A\u0631\u06CC\u0646
    \u062F\u0646\u062F\u0627\u0646 \u0627\u0632 \u0646\u0638\u0631 \u0627\u0646\u062F\u0627\u0632\u0647
    \u0628\u06CC\u0646 \u0627\u06CC\u0646\u0633\u06CC\u0632\u0648\u0631 \u0647\u0627
    \u0645\u06CC \u0628\u0627\u0634\u062F.\r\n\u2022 \u0627\u0632 \u0628\u0639\u062F
    \u0645\u0632\u06CC\u0648\u062F\u06CC\u0633\u062A\u0627\u0644 \u067E\u0647\u0646
    \u062A\u0631\u06CC\u0646 \u062F\u0646\u062F\u0627\u0646 \u0642\u062F\u0627\u0645\u06CC
    \u0627\u0633\u062A.\r\n\u2022 \u0641\u0631\u0645 \u06A9\u0644\u06CC \u062A\u0627\u062C
    \u0627\u0632 \u062F\u06CC\u062F \u0644\u0628\u06CC\u0627\u0644 \u0648 \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644
    \u0630\u0648\u0632\u0646\u0642\u0647 \u0627\u06CC \u0634\u06A9\u0644 \u0648 \u0627\u0632
    \u062F\u06CC\u062F \u0645\u0632\u06CC\u0627\u0644 \u0648 \u062F\u06CC\u0633\u062A\u0627\u0644
    \u0645\u062B\u0644\u062B\u06CC \u0634\u06A9\u0644 \u0627\u0633\u062A.\r\n\u2022
    \u062F\u0631 \u0639\u0645\u0644 \u0628\u0631\u06CC\u062F\u0646 \u0648 \u06AF\u0627\u0632
    \u06AF\u0631\u0641\u062A\u0646 \u0645\u0648\u0627\u062F \u063A\u0630\u0627\u06CC\u06CC\u060C\u062A\u06A9\u0644\u0645
    \u0628\u0639\u0636\u06CC \u0635\u062F\u0627\u0647\u0627 \u060C \u062D\u0641\u0638
    \u06A9\u0644\u06CC \u0634\u06A9\u0644 \u0635\u0648\u0631\u062A \u0648 \u0632\u06CC\u0628\u0627\u06CC\u06CC
    \u0646\u0642\u0634 \u062F\u0627\u0631\u062F.\r\n\u2022 \u062F\u0631 \u062F\u0646\u062F\u0627\u0646
    \u0647\u0627\u06CC \u062A\u0627\u0632\u0647 \u0631\u0648\u06CC\u06CC\u062F\u0647
    \u062F\u0631 \u0644\u0628\u0647 \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644
    3 \u0645\u0627\u0645\u0644\u0648\u0646 \u0645\u06CC\u0646\u0627\u06CC\u06CC \u06AF\u0627\u0647\u06CC
    \u062F\u06CC\u062F\u0647 \u0645\u06CC \u0634\u0648\u062F.\r\n\r\n<color=yellow>\u0646\u0645\u0627\u06CC
    \u0644\u0628\u06CC\u0627\u0644:</color>\n\u0633\u0637\u062D \u0644\u0628\u06CC\u0627\u0644
    \u062F\u0631 \u062F\u0648 \u0628\u0639\u062F \u0645\u0632\u06CC\u0648\u062F\u06CC\u0633\u062A\u0627\u0644
    \u0648 \u0627\u06CC\u0646\u0633\u06CC\u0632\u0648\u0633\u0631\u0648\u06CC\u06A9\u0627\u0644
    \u0645\u062D\u062F\u0628 \u0627\u0633\u062A. \u062D\u062F\u0627\u06A9\u062B\u0631
    \u062A\u062E\u0631\u06CC\u0628 \u0622\u0646 \u062F\u0631 1/3  \u0633\u0631\u0648\u06CC\u06A9\u0627\u0644
    \u0627\u0633\u062A.\r\n\u062D\u062F \u0645\u0632\u06CC\u0627\u0644: \u062D\u062F\u0627\u06A9\u062B\u0631
    \u0628\u06CC\u0631\u0648\u0646 \u0632\u062F\u06AF\u06CC \u0622\u0646 \u062F\u0631
    \u0645\u0646\u0637\u0642\u0647 \u062A\u0645\u0627\u0633 \u0648 \u062F\u0631 1/3
    \ \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644 \u0627\u0633\u062A.\r\n\u062D\u062F
    \u062F\u06CC\u0633\u062A\u0627\u0644: \u062D\u062F\u0627\u06A9\u062B\u0631 \u0628\u06CC\u0631\u0648\u0646
    \u0632\u062F\u06AF\u06CC \u062F\u0631 \u0645\u0646\u0637\u0642\u0647 \u062A\u0645\u0627\u0633
    \u0648 \u0646\u0632\u062F\u06CC\u06A9 \u0628\u0647 \u0645\u062D\u0644 \u0627\u062A\u0635\u0627\u0644
    1/3  \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644 \u0648 1/3 \u0648\u0633\u0637
    \u062F\u0646\u062F\u0627\u0646 \u0627\u0633\u062A.\r\n\u062D\u062F \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644:
    \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0633\u0647 \u0645\u0627\u0645\u0644\u0648\u0646
    \u062F\u06CC\u062F\u0647 \u0634\u0648\u062F \u06A9\u0647 \u0645\u0627\u0645\u0644\u0648\u0646
    \u0648\u0633\u0637\u06CC \u0627\u0632 \u0647\u0645\u0647 \u06A9\u0648\u0686\u06A9\u062A\u0631
    \u0627\u0633\u062A.\r\n\u062D\u062F \u0633\u0631\u0648\u06CC\u06A9\u0627\u0644:
    CEJ  \u0628\u0647 \u0637\u0648\u0631 \u06CC\u06A9\u0646\u0648\u0627\u062E\u062A
    \u0628\u0647 \u0637\u0631\u0641 \u0631\u06CC\u0634\u0647 \u0642\u0648\u0633 \u0628\u0631\u0645\u06CC\u062F\u0627\u0631\u062F\u060C
    \u0627\u0632 \u0646\u0638\u0631 \u0645\u0632\u06CC\u0648\u062F\u06CC\u0633\u062A\u0627\u0644
    \u062A\u0627\u062C \u062F\u0631 \u0646\u0627\u062D\u06CC\u0647 \u0633\u0631\u0648\u06CC\u06A9\u0627\u0644
    \u0628\u0627\u0631\u06CC\u06A9 \u062A\u0631 \u0627\u0632 \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644
    \u0627\u0633\u062A.\r\n\u2022 \u062F\u0631 \u0627\u06CC\u0646 \u0633\u0637\u062D
    \u062F\u0648 \u06AF\u0648\u062F\u06CC \u0637\u0648\u0644\u06CC \u06A9\u0647 \u0627\u0632
    \u0644\u0628\u0647 \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644 \u0628\u0647
    \u0637\u0631\u0641 \u0698\u0646\u0632\u06CC\u0648\u0627\u0644 \u0645\u06CC\u0631\u0648\u062F
    \u0648 \u062F\u0631 1/3  \u0648\u0633\u0637 \u062E\u062A\u0645 \u0645\u06CC\u0634\u0648\u062F\u060C
    \u062F\u06CC\u062F\u0647 \u0645\u06CC\u0634\u0648\u062F.\r\n\u2022 \u062E\u0637\u0648\u0637
    \u0639\u0631\u0636\u06CC (Imbrication) \u062F\u0631 1/3  \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644
    \u062F\u06CC\u062F\u0647 \u0645\u06CC \u0634\u0648\u062F.\r\n\r\n<color=yellow>\u0646\u0645\u0627\u06CC
    \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644:</color>\n\r\u2022 \u0639\u0631\u0636
    \u0645\u0632\u06CC\u0648\u062F\u06CC\u0633\u062A\u0627\u0644 \u0627\u06CC\u0646
    \u0633\u0637\u062D \u06A9\u0645\u062A\u0631 \u0627\u0632 \u0633\u0637\u062D \u0644\u06CC\u0628\u0627\u0644
    \u0627\u0633\u062A\r\n\u2022 2/1 \u06CC\u0627 3/2 \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644\u06CC
    \u0627\u06CC\u0646 \u0633\u0637\u062D \u062A\u0639\u0642\u0631 \u06A9\u0645 \u0639\u0645\u0642\u06CC
    \u0628\u0647 \u0646\u0627\u0645 \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644 \u0641\u0648\u0633\u0627
    \u062F\u0627\u0631\u062F.\r\n\u2022 1/3 \u0633\u0631\u0648\u06CC\u06A9\u0627\u0644\u06CC
    \u0627\u06CC\u0646 \u0633\u0637\u062D \u062A\u062D\u062F\u0628\u06CC \u0628\u0647
    \u0646\u0627\u0645 \u0633\u06CC\u0646\u06AF\u0648\u0644\u0648\u0645 \u062F\u0627\u0631\u062F.\r\n\u2022
    CEJ \u0646\u0633\u0628\u062A \u0628\u0647 \u0633\u0637\u062D \u0644\u0628\u06CC\u0627\u0644
    \u062F\u0627\u0631\u0627\u06CC \u0642\u0648\u0633 \u0639\u0645\u06CC\u0642\u062A\u0631\u06CC
    \u0627\u0633\u062A \u0648 \u0642\u0644\u0647 \u06CC \u0627\u0646\u062D\u0646\u0627\u06CC
    \u0642\u0648\u0633 \u0628\u0647 \u0633\u0645\u062A \u062F\u06CC\u0633\u062A\u0627\u0644
    \u0627\u0633\u062A.\r\n\u2022 \u062F\u0648 \u0645\u0627\u0631\u0698\u06CC\u0646\u0627\u0644
    \u0631\u06CC\u062C \u0645\u0632\u06CC\u0627\u0644 \u0648 \u062F\u06CC\u0633\u062A\u0627\u0644
    \u062F\u0631 \u062F\u0648 \u0637\u0631\u0641 \u062F\u06CC\u062F\u0647 \u0645\u06CC
    \u0634\u0648\u062F.\r\n\u2022 \u06AF\u0627\u0647\u06CC \u0631\u0648\u06CC \u0633\u06CC\u0646\u06AF\u0644\u0648\u0645
    \u0634\u06CC\u0627\u0631\u06CC \u0628\u0647 \u0646\u0627\u0645 Linguogingival
    \u0648\u062C\u0648\u062F \u062F\u0627\u0631\u062F \u0648 \u062F\u0631 \u0645\u0631\u06A9\u0632
    \u0627\u06CC\u0646 \u0634\u06CC\u0627\u0631 \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644
    \u067E\u06CC\u062A \u0627\u0633\u062A.\r\n\u2022 H.OFC \u0627\u06CC\u0646 \u0646\u0645\u0627
    \u062F\u06311/3 \u0633\u0631\u0648\u06CC\u06A9\u0627\u0644\u060C \u06CC\u0639\u0646\u06CC
    \u062D\u062F\u0627\u06A9\u062B\u0631 \u0628\u0631\u062C\u0633\u062A\u06AF\u06CC
    \u0633\u06CC\u0646\u06AF\u0644\u0648\u0645 \u0648\u062C\u0648\u062F \u062F\u0627\u0631\u062F.\r\n\r\n<color=yellow>\u0646\u0645\u0627\u06CC
    \u0645\u0632\u06CC\u0627\u0644:</color>\n\u2022 \u062D\u0627\u0634\u06CC\u0647
    \u0644\u0628\u06CC\u0627\u0644: H.OFC  \u062F\u0631 1/3 \u0698\u0646\u0698\u06CC\u0648\u0627\u0644\r\n\u2022
    \u062D\u0627\u0634\u06CC\u0647 \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644:  H.OFC\u062F\u0631
    1/3  \u0698\u0646\u0698\u06CC\u0648\u0627\u0644\r\n\u2022 CEJ \u062F\u0631 \u0627\u06CC\u0646
    \u0646\u0645\u0627 \u0639\u0645\u06CC\u0642 \u062A\u0631\u06CC\u0646 \u0642\u0648\u0633
    \u0631\u0627 \u062F\u0627\u0631\u062F.\r\n\u2022 H.OFC \u0645\u0632\u06CC\u0627\u0644
    \u062F\u0631 1/3 \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644 \u0648 \u0645\u0646\u0637\u0642\u0647
    \u062A\u0645\u0627\u0633 \u0628\u06CC\u0636\u06CC \u0634\u06A9\u0644 \u0627\u0633\u062A
    \u0648 \u062F\u0631 \u062E\u0637 \u0648\u0633\u0637 \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644
    \u0627\u0633\u062A.\r\n\u2022 \u0641\u0642\u0637 \u062F\u0631 \u0627\u06CC\u0646
    \u062F\u0646\u062F\u0627\u0646 \u0627\u0633\u062A \u062F\u0631 \u0641\u06A9 \u0628\u0627\u0644\u0627
    \u06A9\u0647 \u062A\u0645\u0627\u0633 \u0645\u0632\u06CC\u0627\u0644 \u062F\u0646\u062F\u0627\u0646
    \u06A9\u0646\u0627\u0631\u06CC \u0627\u0633\u062A.\r\n\r\n<color=yellow>\u0646\u0645\u0627\u06CC
    \u062F\u06CC\u0633\u062A\u0627\u0644:</color>\n\u2022 \u0646\u0645\u0627\u06CC
    \u062F\u06CC\u0633\u062A\u0627\u0644 \u0634\u0628\u06CC\u0647 \u0633\u0637\u062D
    \u0645\u0632\u06CC\u0627\u0644 \u0628\u0647 \u062C\u0632 :\r\n\u2022 \u0627\u0631\u062A\u0641\u0627\u0639
    \u0627\u06CC\u0646\u0633\u06CC\u0632\u0648\u0633\u0631\u0648\u06CC\u06A9\u0627\u0644
    \u0627\u06CC\u0646 \u0633\u0637\u062D \u0645\u062D\u062F\u0628 \u062A\u0631 \u0627\u0633\u062A
    \u0648  CEJ \u0642\u0648\u0633 \u06A9\u0645\u062A\u0631\u06CC \u062F\u0627\u0631\u062F
    .\r\n\u2022 \u0645\u0646\u0637\u0642\u0647 \u062A\u0645\u0627\u0633 \u0622\u0646
    \u06A9\u0648\u0686\u06A9\u062A\u0631 \u0627\u0633\u062A.\r\n\u2022 H.OFC \u062F\u0631
    \u0645\u062D\u0644 \u0627\u062A\u0635\u0627\u06441/3 \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644
    \u0648 1/3 \u0645\u06CC\u0627\u0646\u06CC \u0627\u0633\u062A.\r\n\r\n<color=yellow>\u0646\u0645\u0627\u06CC
    \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644:</color>\n\u2022 \u062A\u062D\u062F\u0628
    \u0633\u06CC\u06AF\u0646\u0648\u0645 \u0628\u0647 \u0637\u0631\u0641 \u062F\u06CC\u0633\u062A\u0627\u0644
    \u0627\u0633\u062A.\r\n\u2022 \u0644\u0628\u0647 \u06CC \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644
    \u0645\u0633\u062A\u0642\u06CC\u0645\u0627 \u0627\u0632 \u0645\u0632\u06CC\u0627\u0644
    \u0628\u0647 \u062F\u06CC\u0633\u062A\u0627\u0644 \u06A9\u0634\u06CC\u062F\u0647
    \u0634\u062F\u0647 \u0627\u0633\u062A.\r\n\u2022 \u0644\u0628\u0647 \u06CC \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644
    \u062F\u0627\u0631\u0627\u06CC \u0634\u06CC\u0628 \u0627\u0632\u0644\u06CC\u0628\u0627\u0644
    \u0628\u0647 \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644 \u0627\u0633\u062A.\r\n\r\n<color=yellow>\u0631\u06CC\u0634\u0647:</color>\n\u2022
    \u0631\u06CC\u0634\u0647 \u062A\u06A9\u06CC \u0627\u0633\u062A \u0648 \u0645\u062E\u0631\u0648\u0637\u06CC
    \u0648 \u0645\u0633\u062A\u0642\u06CC\u0645 \u0628\u0627 \u06CC\u06A9 \u0627\u067E\u06A9\u0633
    \u06A9\u0627\u0645\u0644\u0627 \u06AF\u0631\u062F \u0634\u062F\u0647 \u062F\u0627\u0631\u062F.\r\n\u2022
    \u0637\u0648\u0644 \u0631\u06CC\u0634\u0647 1.5  \u0628\u0631\u0627\u0628\u0631
    \u0637\u0648\u0644 \u062A\u0627\u062C \u0627\u0633\u062A.\r\n\u2022 \u0627\u0632
    \u0628\u0639\u062F \u0644\u0628\u06CC\u0648\u0644\u06CC\u0646\u06AF\u0648\u0627\u0644
    \u067E\u0647\u0646 \u062A\u0631 \u0627\u0632 \u0645\u0632\u06CC\u0648\u062F\u06CC\u0633\u062A\u0627\u0644
