  teethName: 5 - (R) First Premolar
  teethBio: "\u2022 \u067E\u0631\u0645\u0648\u0644\u0631 \u0647\u0627 \u0648 \u0645\u0648\u0644\u0631
    \u0647\u0627 \u0628\u0627\u0647\u0645 \u062F\u0646\u062F\u0627\u0646 \u0647\u0627\u06CC
    \u062E\u0644\u0641\u06CC \u0631\u0627 \u0645\u06CC \u0633\u0627\u0632\u0646\u062F.\r\n\u2022
    \u067E\u0631\u0645\u0648\u0644\u0631\u0647\u0627 \u062F\u0648 \u06A9\u0627\u0633\u067E\u06CC
    \u0647\u0633\u062A\u0646\u062F \u0648 \u0648\u0638\u06CC\u0641\u0647 \u0622\u0646\u0647\u0627
    \u0628\u06CC\u0634\u062A\u0631 \u062C\u0648\u06CC\u062F\u0646 \u0627\u0633\u062A
    \u0648 \u0627\u0632 \u0646\u0638\u0631 \u0632\u06CC\u0628\u0627\u06CC\u06CC \u0641\u0648\u0646\u062A\u06CC\u06A9
    \u0646\u06CC\u0632 \u062D\u0627\u0626\u0632 \u0627\u0647\u0645\u06CC\u062A \u0647\u0633\u062A\u0646\u062F.\r\n\u2022
    \u067E\u0631\u0645\u0648\u0644\u0631 \u0647\u0627 \u0645\u0639\u0645\u0648\u0644\u0627
    \u06CC\u06A9 \u06A9\u0627\u0633\u067E \u0628\u0627\u06A9\u0627\u0644 \u0648 1
    \u06CC\u0627 2 \u06A9\u0627\u0633\u067E \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644
    \u062F\u0627\u0631\u0646\u062F.\r\n\u2022 \u0686\u0648\u0646 \u062C\u0627\u0646\u0634\u06CC\u0646
    \u062F\u0646\u062F\u0627\u0646 \u0647\u0627\u06CC \u0634\u06CC\u0631\u06CC \u0645\u06CC\u0634\u0648\u0646\u062F
    \u0628\u0647 \u0622\u0646\u0647\u0627 \u062F\u0646\u062F\u0627\u0646 \u0647\u0627\u06CC
    \u062C\u0627\u0646\u0634\u06CC\u0646 \u0645\u06CC\u06AF\u0648\u06CC\u0646\u062F.\r\n\u2022
    \u0647\u0631\u062F\u0648 \u067E\u0631\u0645\u0648\u0644\u0631 \u0628\u0627\u0644\u0627
    \u062F\u0627\u0631\u0627\u06CC \u062F\u0648 \u06A9\u0627\u0633\u067E \u062A\u06CC\u0632
    \u0648 \u0645\u0634\u062E\u0635 \u0648 \u062A\u0642\u0631\u06CC\u0628\u0627 \u0647\u0645
    \u0627\u0646\u062F\u0627\u0632\u0647 \u0647\u0633\u062A\u0646\u062F.\r\n\u2022
    \u0627\u0632 \u062F\u06CC\u062F \u067E\u0631\u0648\u06AF\u0632\u06CC\u0645\u0627\u0644
    \u062A\u0627\u062C \u067E\u0631\u0645\u0648\u0644\u0631 \u0628\u0627\u0644\u0627
    \u0647\u06CC\u062C \u062A\u0645\u0627\u06CC\u0644 \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644\u06CC
    \u0646\u062F\u0627\u0631\u062F.\r\n\u2022 \u0627\u0632 \u062F\u06CC\u062F \u0627\u06A9\u0644\u0648\u0632\u0627\u0644
    \u0647\u0631 \u062F\u0648 \u067E\u0631\u0645\u0648\u0644\u0631 \u062F\u0631 \u062C\u0647\u062A
    \u0628\u0627\u06A9\u0648\u0644\u06CC\u0646\u06AF\u0648\u0627\u0644 \u067E\u0647\u0646
    \u062A\u0631 \u0627\u0632 \u0645\u0632\u06CC\u0648 \u062F\u06CC\u0633\u062A\u0627\u0644
    \u0627\u0633\u062A.\r\n\u2022 \u0627\u0631\u062A\u0641\u0627\u0639 \u062A\u0627\u062C
    \u067E\u0631\u0645\u0648\u0644\u0631 \u0647\u0627\u06CC \u0628\u0627\u0644\u0627
    \u06A9\u0645\u062A\u0631 \u0627\u0632 \u062F\u0646\u062F\u0627\u0646 \u0647\u0627\u06CC
    \u0642\u062F\u0627\u0645\u06CC \u0627\u0633\u062A \u0627\u0645\u0627 \u0628\u06CC\u0634\u062A\u0631
    \u0627\u0632 \u0645\u0648\u0644\u0631 \u0647\u0627\u06CC \u0628\u0627\u0644\u0627
    \u0627\u0633\u062A.\r\n\u2022 \u067E\u0631\u0645\u0648\u0644\u0631 \u06CC\u06A9
    \u0628\u0627\u0644\u0627 \u0686\u0647\u0627\u0631\u0645\u06CC\u0646 \u062F\u0646\u062F\u0627\u0646
    \u0627\u0632 \u062E\u0637 \u0648\u0633\u0637 \u0627\u0633\u062A \u06A9\u0647 \u062F\u0627\u0631\u0627\u06CC
    \u062A\u0645\u0627\u0633 \u0645\u0632\u06CC\u0627\u0644 \u0628\u0627 \u06A9\u0627\u0646\u06CC\u0646
    \u0648 \u062A\u0645\u0627\u0633 \u062F\u06CC\u0633\u062A\u0627\u0644 \u0628\u0627
    \u067E\u0631\u0645\u0648\u0644\u0631 \u062F\u0648\u0645 \u0627\u0633\u062A.\r\n\u2022
    \u062F\u0631 \u0633\u06CC\u0633\u062A\u0645 \u062C\u0647\u0627\u0646\u06CC \u067E\u0631\u0645\u0648\u0644\u0631
    \u0627\u0648\u0644 \u0631\u0627\u0633\u062A \u0628\u0627\u0644\u0627 \u0628\u0627
    \u0639\u062F\u062F 5 \u0648 \u062F\u0631 \u0633\u06CC\u0633\u062A\u0645 F.D.I
    \u0628\u0627 \u0634\u0645\u0627\u0631\u0647 14 \u0645\u0634\u062E\u0635 \u0645\u06CC\u0634\u0648\u062F.\r\n\r\n<color=yellow>\u0646\u0645\u0627\u06CC
    \u0628\u0627\u06A9\u0627\u0644:</color>\n\u2022 \u0627\u0632 \u062F\u06CC\u062F
    \u0628\u0627\u06A9\u0627\u0644 \u067E\u0631\u0645\u0648\u0644\u0631 \u0627\u0648\u0644
    \u0628\u0647 \u0634\u062F\u062A \u0634\u0628\u06CC\u0647 \u06A9\u0627\u0646\u06CC\u0646
    \u0628\u0627\u0644\u0627 \u0648 \u067E\u0631\u0645\u0648\u0644\u0631 \u062F\u0648\u0645
    \u0627\u0633\u062A.\r\n\u2022 \u0627\u0632 \u06A9\u0627\u0646\u06CC\u0646 \u06A9\u0645\u06CC
    \u0628\u0632\u0631\u06AF\u062A\u0631 \u0648 \u06A9\u0627\u0633\u067E \u0622\u0646
    \u0628\u0631\u062C\u0633\u062A\u0647 \u062A\u0631 \u0627\u0633\u062A.\r\n\u2022
    \u062A\u0627\u062C \u0627\u0632 \u062F\u06CC\u062F \u0628\u0627\u06A9\u0627\u0644
    5 \u0636\u0644\u0639\u06CC \u0627\u0633\u062A.\r\n\u2022 \u0642\u0633\u0645\u062A
    \u0627\u06A9\u0644\u0648\u0632\u0627\u0644\u06CC \u062D\u0627\u0634\u06CC\u0647
    \u0645\u0632\u06CC\u0627\u0644 \u0645\u062D\u062F\u0628 \u0628\u0627 \u062D\u062F\u0627\u06A9\u062B\u0631
    \u0628\u0631\u062C\u0633\u062A\u06AF\u06CC \u0627\u0633\u062A \u0648 \u0642\u0633\u0645\u062A
    \u0698\u0646\u0698\u06CC\u0648\u0627\u0644\u06CC \u0627\u06CC\u0646 \u062D\u0627\u0634\u06CC\u0647
    \u06A9\u0645 \u06A9\u0645 \u0645\u0642\u0639\u0631 \u0645\u06CC\u0634\u0648\u062F.\r\n\u2022
    \u062D\u0627\u0634\u06CC\u0647 \u062F\u06CC\u0633\u062A\u0627\u0644 \u0634\u0628\u06CC\u0647
    \u062D\u0627\u0634\u06CC\u0647 \u0645\u0632\u06CC\u0627\u0644 \u0627\u0633\u062A
