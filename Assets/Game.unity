  originalText: "\u062F\u0646\u062A\u0627\u0644 \u06CC\u0627\u0631 \u062A\u06CC\u0645\u06CC
    \u0634\u0627\u0645\u0644 \u06AF\u0631\u0648\u0647 \u062F\u0646\u062F\u0627\u0646\u067E\u0632\u0634\u06A9\u06CC
    \u0648 \u0628\u0631\u0646\u0627\u0645\u0647 \u0646\u0648\u06CC\u0633\u06CC \u0627\u0633\u062A\n\r\n\u0645\u0627
