    \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644 \u06A9\u0648\u062A\u0627\u0647\u062A\u0631
    \u0627\u0632 \u06A9\u0627\u0633\u067E \u0628\u0627\u06A9\u0627\u0644 \u0627\u0633\u062A.\r\n\u2022
