    \u0645\u062B\u0644\u062B\u06CC \u0645\u0632\u06CC\u0627\u0644 \u0627\u0633\u062A\u060C
    \u06A9\u0645\u06CC \u06A9\u0645 \u0639\u0645\u0642 \u062A\u0631 \u0627\u0633\u062A
    \u062F\u0631 \u0627\u06CC\u0646 \u062F\u0646\u062F\u0627\u0646 3 \u067E\u06CC\u062A
    \u0645\u0634\u0627\u0647\u062F\u0647 \u0645\u06CC\u0634\u0648\u062F.\r\n\u2022
    \u067E\u06CC\u062A \u0633\u0646\u062A\u0631\u0627\u0644 \u06A9\u0647 \u0645\u062D\u0644
