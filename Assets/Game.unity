    \u0645\u06CC\u0634\u0648\u062F.\r\n\u2022 \u0631\u06CC\u0634\u0647 \u06CC \u0628\u0627\u06A9\u0627\u0644
    \u0627\u0632 \u0646\u0638\u0631 \u0627\u0646\u062F\u0627\u0632\u0647 \u0628\u0632\u0631\u06AF\u062A\u0631
    \u0627\u0633\u062A.\r\n\u2022 \u0637\u0648\u0644 \u0647\u0631 \u062F\u0648 \u0631\u06CC\u0634\u0647
    \u062A\u0642\u0631\u06CC\u0628\u0627 \u0628\u0631\u0627\u0628\u0631 \u0627\u0633\u062A.\r\n\u2022
    \u062F\u0631 \u0633\u0637\u062D \u0628\u0627\u06A9\u0627\u0644 \u0648 \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644
