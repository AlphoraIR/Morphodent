    \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644:</color>\n\u2022 \u0627\u0631\u062A\u0641\u0627\u0639
    \u0622\u0646 \u06A9\u0645\u06CC \u0627\u0632 \u06A9\u0627\u0633\u067E \u0628\u0627\u06A9\u0627\u0644
    \u06A9\u0645\u062A\u0631 \u0627\u0633\u062A \u0648 \u0645\u062B\u0644 \u06A9\u0627\u0633\u067E
    \u0628\u0627\u06A9\u0627\u0644 \u062F\u0627\u0631\u0627\u06CC 4 \u0631\u06CC\u062C
    \u0627\u0633\u062A.\r\n\u2022 \u0631\u0627\u0633 \u0627\u06CC\u0646 \u06A9\u0627\u0633\u067E
    \u06A9\u0645\u06CC \u0628\u0647 \u0637\u0631\u0641 \u0645\u0632\u06CC\u0627\u0644
    \u0627\u0633\u062A.\r\n\u2022 \u0628\u0647 \u0631\u06CC\u062C \u0628\u0627\u06A9\u0627\u0644
    \u06A9\u0627\u0633\u067E \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644\u060C \u0631\u06CC\u062C
    \u0645\u062B\u0644\u062B\u06CC \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644 \u0646\u06CC\u0632
    \u06AF\u0641\u062A\u0647 \u0645\u06CC\u0634\u0648\u062F.\r\n\r\n\r\n<color=yellow>\u0631\u06CC\u062C
    \u0639\u0631\u0636\u06CC:</color>\n\u2022 \u0627\u0632 \u0628\u0647\u0645 \u0631\u0633\u06CC\u062F\u0646
    \u0631\u06CC\u062C \u0647\u0627\u06CC \u0645\u062B\u0644\u062B\u06CC \u06A9\u0627\u0633\u067E
    \u0628\u0627\u06A9\u0627\u0644 \u0648 \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644
    \u0631\u06CC\u062C \u0639\u0631\u0636\u06CC \u0633\u0627\u062E\u062A\u0647 \u0645\u06CC\u0634\u0648\u062F.\r\n\r\n<color=yellow>\u0645\u0627\u0631\u0698\u06CC\u0646\u0627\u0644
    \u0631\u06CC\u062C:</color>\n\u2022 \u0645\u0627\u0631\u0698\u06CC\u0646\u0627\u0644
    \u0631\u06CC\u062C \u0645\u0632\u06CC\u0627\u0644 \u0648 \u062F\u06CC\u0633\u062A\u0627\u0644
    \u0628\u0631\u062E\u0644\u0627\u0641 \u062F\u0646\u062F\u0627\u0646 \u0647\u0627\u06CC
    \u0642\u062F\u0627\u0645\u06CC \u0628\u0647 \u0635\u0648\u0631\u062A \u0627\u0641\u0642\u06CC
    \u0627\u0633\u062A.\r\n\u2022 \u0645\u0627\u0631\u0698\u06CC\u0646\u0627\u0644
    \u0631\u06CC\u062C \u0645\u0632\u06CC\u0627\u0644 \u06A9\u0645\u06CC \u06A9\u0648\u062A\u0627\u0647\u062A\u0631
    \u0627\u0632 \u062F\u06CC\u0633\u062A\u0627\u0644 \u0627\u0633\u062A \u0648 \u062A\u0648\u0633\u0637
    \u0634\u06CC\u0627\u0631 \u0645\u0627\u0631\u0698\u06CC\u0646\u0627\u0644 \u0645\u0632\u06CC\u0627\u0644
    \u0642\u0637\u0639 \u0645\u06CC\u0634\u0648\u062F.\r\n\r\n<color=yellow>\u0641\u0648\u0633\u0627:</color>\n\u2022
    \u0641\u0648\u0633\u0627\u06CC \u0645\u062B\u0644\u062B\u06CC \u0645\u0632\u06CC\u0627\u0644
    \u062A\u0648\u0633\u0637 4 \u0639\u0646\u0635\u0631 \u0645\u062D\u062F\u0648\u062F
    \u0645\u06CC\u0634\u0648\u062F:\r\n5. \u0645\u0627\u0631\u0698\u06CC\u0646\u0627\u0644
    \u0631\u06CC\u062C \u0645\u0632\u06CC\u0627\u0644\r\n6. \u0631\u06CC\u062C \u0639\u0631\u0636\u06CC\r\n7.
    \u0631\u06CC\u062C \u0645\u0632\u06CC\u0627\u0644 \u06A9\u0627\u0633\u067E \u0628\u0627\u06A9\u0627\u0644\r\n8.
    \u0631\u06CC\u062C \u0645\u0632\u06CC\u0627\u0644 \u06A9\u0627\u0633\u067E \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644\r\n\r\n\u2022
    \u0641\u0648\u0633\u0627\u06CC \u0645\u062B\u0644\u062B\u06CC \u062F\u06CC\u0633\u062A\u0627\u0644
    \u0639\u06CC\u0646\u0627 \u0634\u0628\u06CC\u0647 \u0641\u0648\u0633\u0627\u06CC
    \u0645\u0632\u06CC\u0627\u0644 \u0627\u0645\u0627 \u0627\u0646\u062F\u0627\u0632\u0647
    \u0648 \u0639\u0645\u0642 \u0622\u0646 \u06A9\u0645\u062A\u0631 \u0627\u0633\u062A.\r\n\r\n<color=yellow>\u06AF\u0648\u062F\u0627\u0644\u0647\u0627
    \u0648 \u0634\u06CC\u0627\u0631\u0647\u0627:</color>\n\u2022 \u062F\u0648 Pit
    \u062F\u06CC\u062F\u0647 \u0645\u06CC\u0634\u0648\u062F.\r\n\u2022 \u067E\u06CC\u062A
    \u0645\u0632\u06CC\u0627\u0644 \u06A9\u0647 \u062F\u0631 \u0648\u0633\u0637 \u062A\u0642\u0627\u0637\u0639
    4 \u0634\u06CC\u0627\u0631 \u0631\u0634\u062F\u06CC \u0642\u0631\u0627\u0631 \u062F\u0627\u0631\u062F.\r\n5.
    \u0634\u06CC\u0627\u0631 \u0645\u062B\u0644\u062B\u06CC \u0645\u0632\u06CC\u0648\u0644\u06CC\u0646\u06AF\u0648\u0627\u0644\r\n6.
    \u0634\u06CC\u0627\u0631 \u0645\u0632\u06CC\u0648 \u0645\u0627\u0631\u0698\u06CC\u0646\u0627\u0644
    \u0631\u06CC\u062C\r\n7. \u0634\u06CC\u0627\u0631 \u0645\u062B\u0644\u062B\u06CC
    \u0645\u0632\u06CC\u0648 \u0628\u0627\u06A9\u0627\u0644\r\n8. \u0634\u06CC\u0627\u0631
    \u0633\u0646\u062A\u0631\u0627\u0644\r\n\u2022 \u0647\u0631 4 \u0634\u06CC\u0627\u0631
    \u062A\u06A9\u0627\u0645\u0644\u06CC \u0648 \u0627\u0648\u0644\u06CC\u0647 \u0647\u0633\u062A\u0646\u062F.\r\n\u2022
    \u067E\u06CC\u062A \u062F\u06CC\u0633\u062A\u0627\u0644 \u06A9\u0647 \u062F\u0631
    \u0648\u0633\u0637 \u062A\u0642\u0627\u0637\u0639 4 \u0634\u06CC\u0627\u0631 \u0631\u0634\u062F\u06CC
    \u0645\u062B\u0644 \u067E\u06CC\u062A \u0645\u0632\u06CC\u0627\u0644 \u0642\u0631\u0627\u0631
    \u062F\u0627\u0631\u062F.\r\n\r\n<color=yellow>\u0631\u06CC\u0634\u0647:</color>\n\u2022
    \u0646\u0648\u0639 \u0634\u0627\u06CC\u0639 \u067E\u0631\u0645\u0648\u0644\u0631
    1 \u0645\u0627\u06AF\u0632\u06CC\u0644\u0627 \u0631\u06CC\u0634\u0647 \u06CC \u062F\u0648\u06AF\u0627\u0646\u0647
    \u0627\u0633\u062A.\r\n\u2022 \u062A\u0646\u0647 \u06CC \u0631\u06CC\u0634\u0647
    \u0628\u0647 \u062F\u0648 \u0634\u0627\u062E\u0647 \u06CC \u0628\u0627\u06A9\u0627\u0644
    \u0648 \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644 \u062A\u0642\u0633\u06CC\u0645
    \u0645\u06CC\u0634\u0648\u062F.\r\n\u2022 \u062A\u0645\u0627\u0645 \u0633\u0637\u0648\u062D
    \u0631\u06CC\u0634\u0647 \u0647\u0627 \u0645\u062D\u062F\u0628 \u0627\u0633\u062A
