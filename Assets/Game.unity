    \u0634\u06CC\u0627\u0631 \u062F\u06CC\u0633\u062A\u0648 \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644
    \u0648\u0634\u06CC\u0627\u0631 \u0645\u0627\u0631\u0698\u06CC\u0646\u0627\u0644
    \u062F\u06CC\u0633\u062A\u0627\u0644 \r\n<color=yellow> \u0631\u06CC\u0634\u0647
    \u0647\u0627:</color>\r\n\u2022 \u0627\u06CC\u0646 \u062F\u0646\u062F\u0627\u0646
    3 \u0631\u06CC\u0634\u0647 \u0628\u0632\u0631\u06AF \u0648 \u0631\u0634\u062F
    \u06CC\u0627\u0641\u062A\u0647 \u062F\u0627\u0631\u062F :\r\n1. \u0631\u06CC\u0634\u0647
    \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644 \u0628\u0632\u0631\u06AF\u062A\u0631\u06CC\u0646
    \u060C \u0628\u0644\u0646\u062F \u062A\u0631\u06CC\u0646 \u0648 \u0645\u062D\u06A9\u0645
    \u062A\u0631\u06CC\u0646 \u0631\u06CC\u0634\u0647 \u06CC \u0627\u06CC\u0646 \u062F\u0646\u062F\u0627\u0646
    \u0627\u0633\u062A \u0648 \u062A\u0645\u0627\u06CC\u0644 \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644\u06CC
    \u062F\u0627\u0631\u062F.\r\n\u2022 \u0631\u06CC\u0634\u0647  \u06CC \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644
    \u062F\u0631 \u062C\u0647\u062A \u0645\u0632\u06CC\u0648 \u062F\u06CC\u0633\u062A\u0627\u0644
    \u067E\u0647\u0646 \u062A\u0631 \u0627\u0632 \u0628\u0627\u06A9\u0648 \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644\u06CC
    \u0627\u0633\u062A .\r\n2. \u0631\u06CC\u0634\u0647 \u0645\u0632\u06CC\u0648 \u0628\u0627\u06A9\u0627\u0644
    \u0627\u0632 \u0646\u0638\u0631 \u0628\u0632\u0631\u06AF\u06CC \u0648 \u0628\u0644\u0646\u062F\u06CC
