    \u062F\u06CC\u0633\u062A\u0648 \u0628\u0627\u06A9\u0627\u0644 \u0648 \u0634\u06CC\u0627\u0631
    \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644.\r\n\u2022 \u067E\u06CC\u062A  \u0645\u0632\u06CC\u0627\u0644
    \u0645\u062D\u0644 \u062A\u0644\u0627\u0642\u06CC 4 \u0634\u06CC\u0627\u0631 \u0631\u0634\u062F\u06CC
    \u0627\u0633\u062A\u060C \u0634\u06CC\u0627\u0631 \u0633\u0646\u062A\u0631\u0627\u0644
    \u0642\u0633\u0646\u062A \u0645\u0632\u06CC\u0627\u0644 \u0622\u0646\u060C \u0634\u06CC\u0627\u0631
    \u0645\u062B\u0644\u062B\u06CC \u0645\u0632\u06CC\u0648 \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644\u060C
    \u0634\u06CC\u0627\u0631 \u0645\u062B\u0644\u062B\u06CC \u062F\u06CC\u0633\u062A\u0648
    \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644 \u0648 \u0634\u06CC\u0627\u0631 \u0645\u0627\u0631\u0698\u06CC\u0646\u0627\u0644
    \u0645\u0632\u06CC\u0627\u0644.\n\u2022 \u067E\u06CC\u062A \u062F\u06CC\u0633\u062A\u0627\u0644
    \u06A9\u0647 \u0645\u062D\u0644 \u062A\u0644\u0627\u0642\u06CC 3 \u0634\u06CC\u0627\u0631
    \u0631\u0634\u062F\u06CC \u0627\u0633\u062A \u0634\u06CC\u0627\u0631 \u0633\u0646\u062A\u0631\u0627\u0644
    \u0642\u0633\u0645\u062A \u062F\u06CC\u0633\u062A\u0627\u0644 \u0622\u0646\u060C
    \u0634\u06CC\u0627\u0631 \u0645\u062B\u0644\u062B\u06CC \u062F\u06CC\u0633\u062A\u0648
