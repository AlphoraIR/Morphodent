  m_Script: {fileID: 11500000, guid: 02c187b07e47c5a41a6f2ab699b6cdd5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  teethName: 27 - (R) Canine
  teethBio: "\u2022 \u0633\u0648\u0645\u06CC\u0646 \u062F\u0646\u062F\u0627\u0646
    \u0627\u0632 \u062E\u0637 \u0648\u0633\u0637 \u06A9\u0647 \u062C\u0627\u0646\u0634\u06CC\u0646
    \u062F\u0646\u062F\u0627\u0646 \u06A9\u0627\u0646\u06CC\u0646 \u0634\u06CC\u0631\u06CC
    \u0645\u06CC\u0634\u0648\u062F \u0648 \u062F\u0627\u0631\u0627\u06CC \u062A\u0645\u0627\u0633
    \u0645\u0632\u06CC\u0627\u0644 \u0628\u0627 \u062F\u0646\u0627\u0646 \u0644\u062A\u0631\u0627\u0644
    \u0648 \u062A\u0645\u0627\u0633 \u062F\u06CC\u0633\u062A\u0627\u0644 \u0628\u0627
    \u067E\u0631\u0645\u0648\u0644\u0631 \u0627\u0648\u0644 \u0627\u0633\u062A.\r\n\u2022
    \u062F\u0646\u062F\u0627\u0646 \u06A9\u0627\u0646\u06CC\u0646 \u0631\u0627\u0633\u062A
    \u0645\u0646\u062F\u06CC\u0628\u0644 \u062F\u0631 \u0633\u06CC\u0633\u062A\u0645
    \u06CC\u0648\u0646\u06CC\u0648\u0631 \u0633\u0627\u0644 \u0628\u0627 \u0634\u0645\u0627\u0631\u0647
    27 \u0648 \u062F\u0631 \u0633\u06CC\u0633\u062A\u0645 F.D.I \u0628\u0627 \u0634\u0645\u0627\u0631\u0647
    43 \u0645\u0634\u062E\u0635 \u0645\u06CC\u0634\u0648\u062F.\r\n\u2022 \u0641\u0631\u0645
    \u0648 \u0641\u0646\u06A9\u0634\u0646 \u0627\u06CC\u0646 \u062F\u0646\u062F\u0627\u0646
    \u0634\u0628\u06CC\u0647 \u06A9\u0627\u0646\u06CC\u0646 \u0628\u0627\u0644\u0627
    \u0627\u0633\u062A.\r\n\u2022 \u0637\u0648\u0644 \u062A\u0627\u062C \u0627\u0632
    \u0646\u0638\u0631 \u0627\u06CC\u0646\u0633\u06CC\u0632\u0648 \u0633\u0631\u0648\u06CC\u06A9\u0627\u0644\u06CC
    \u0628\u0647 \u0627\u0646\u062F\u0627\u0632\u0647 \u06A9\u0627\u0646\u06CC\u0646
    \u0628\u0627\u0644\u0627 \u0648 \u062D\u062A\u06CC \u06A9\u0645\u06CC \u0628\u0644\u0646\u062F\u062A\u0631
    \u0627\u0633\u062A.\r\n\u2022 \u0631\u06CC\u0634\u0647 \u0645\u0639\u0645\u0648\u0644\u0627
    \u06A9\u0648\u062A\u0627\u0647\u062A\u0631 \u0627\u0632 \u06A9\u0627\u0646\u06CC\u0646
    \u0628\u0627\u0644\u0627 \u0627\u0633\u062A.\r\n\u2022 \u0639\u0631\u0636 \u0645\u0632\u06CC\u0648\u062F\u06CC\u0633\u062A\u0627\u0644
    \u0648 \u0644\u0628\u06CC\u0648 \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644 \u062A\u0627\u062C
    \u0648 \u0631\u06CC\u0634\u0647 \u06A9\u0645\u062A\u0631 \u0627\u0632 \u06A9\u0627\u0646\u06CC\u0646
    \u0628\u0627\u0644\u0627 \u0627\u0633\u062A.\r\n\u2022 \u06A9\u0627\u0633\u067E
    \u06A9\u0627\u0646\u06CC\u0646 \u067E\u0627\u06CC\u06CC\u0646 \u0628\u0647 \u0627\u0646\u062F\u0627\u0632\u0647
    \u06CC \u0628\u0627\u0644\u0627 \u0628\u0631\u062C\u0633\u062A\u0647 \u0648 \u062A\u06CC\u0631
    \u0646\u06CC\u0633\u062A.\r\n\r\n<color=yellow>\u0646\u0645\u0627\u06CC \u0644\u0628\u06CC\u0627\u0644:</color>\n\u2022
    \u0634\u06A9\u0644 \u0627\u06CC\u0646 \u0646\u0645\u0627 5 \u0636\u0644\u0639\u06CC
    \u0627\u0633\u062A \u2013 \u0633\u0637\u062D \u0644\u0628\u06CC\u0627\u0644 \u06A9\u0627\u0645\u0644\u0627
    \u0645\u062D\u062F\u0628 \u0646\u06CC\u0633\u062A \u0648 \u0641\u0642\u0637 \u062F\u06311/3
    \u0633\u0631\u0648\u067E\u06A9\u0627\u0644 \u0627\u0632 \u0646\u0638\u0631 \u0645\u0632\u06CC\u0648\u062F\u06CC\u0633\u062A\u0627\u0644
    \u06A9\u0627\u0645\u0644\u0627 \u0645\u062D\u062F\u0628 \u0627\u0633\u062A.\r\n\u2022
    \u062D\u0627\u0634\u06CC\u0647 \u06CC \u0645\u0632\u06CC\u0627\u0644 \u0632\u0627\u0648\u06CC\u0647
    \u0645\u0632\u06CC\u0648\u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644 \u0645\u0646\u0641\u0631\u062C\u0647
    \u0627\u0633\u062A.\r\n\u2022 \u062D\u0627\u0634\u06CC\u0647 \u062F\u06CC\u0633\u062A\u0627\u0644
    \u0627\u0632 \u0646\u0638\u0631 \u0627\u06CC\u0646\u0633\u06CC\u0632\u0648 \u0633\u0631\u0648\u06CC\u06A9\u0627\u0644\u06CC
    \u0645\u062D\u062F\u0628 \u0627\u0633\u062A.\r\n3. \u0632\u0627\u0648\u06CC\u0647
    \u06CC \u062F\u06CC\u0633\u062A\u0648\u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644
    \u06AF\u0631\u062F \u0634\u062F\u0647 \u062A\u0631 \u0627\u0632 \u0645\u0632\u06CC\u0648
    \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644 \u0627\u0633\u062A.\r\n4. \u062D\u0627\u0634\u06CC\u0647
    \u062F\u06CC\u0633\u062A\u0627\u0644 \u06A9\u0648\u062A\u0627\u0647 \u062A\u0631
    \u0627\u0632 \u0645\u0632\u06CC\u0627\u0644 \u0627\u0633\u062A.\r\n\u2022 \u062D\u0627\u0634\u06CC\u0647
    \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644\u06CC \u0645\u0627\u0646\u0646\u062F
    \u06A9\u0627\u0646\u06CC\u0646 \u0628\u0627\u0644\u0627 \u062A\u06CC\u0632\u0648
    \u0628\u0644\u0646\u062F \u0646\u06CC\u0633\u062A.\r\n\u2022 \u0631\u0627\u0633
    \u06A9\u0627\u0633\u067E \u06A9\u0627\u0646\u06CC\u0646 \u067E\u0627\u06CC\u06CC\u0646
    \u0628\u0647 \u0637\u0631\u0641 \u0645\u0632\u06CC\u0627\u0644 \u0627\u0633\u062A
    \u0648 \u0634\u06CC\u0628 \u062F\u06CC\u0633\u062A\u0627\u0644 \u0628\u0644\u0646\u062F
    \u062A\u0631 \u0627\u0633\u062A.\r\n\u2022 \u0627\u06CC\u0646 \u0627\u062E\u062A\u0644\u0627\u0641
    \u0634\u06CC\u0628 \u0628\u0647 \u0639\u0644\u062A \u062A\u0645\u0627\u0633 \u0634\u06CC\u0628
    \u062F\u06CC\u0633\u062A\u0627\u0644 \u06A9\u0627\u0646\u06CC\u0646 \u067E\u0627\u06CC\u06CC\u0646
    \u0628\u0627 \u0634\u06CC\u0628 \u0645\u0632\u06CC\u0627\u0644 \u06A9\u0627\u0646\u06CC\u0646
    \u0628\u0627\u0644\u0627 \u0627\u0633\u062A.\r\n\u2022 H.OFC \u0627\u06CC\u0646
    \u0633\u0637\u062D \u062F\u0631 1/3 \u0633\u0631\u0648\u06CC\u06A9\u0627\u0644
    \u0627\u0633\u062A.\r\n\u2022 \u06AF\u0648\u062F\u06CC \u0647\u0627\u06CC \u0637\u0648\u0644\u06CC
    \u0645\u0632\u06CC\u0627\u0644 \u0648 \u062F\u06CC\u0633\u062A\u0627\u0644 \u062F\u06CC\u062F\u0647
    \u0645\u06CC\u0634\u0648\u062F.\r\n\u2022 Imbrication \u0645\u0639\u0645\u0648\u0644\u0627
    \u062F\u06CC\u062F\u0647 \u0646\u0645\u06CC\u0634\u0648\u062F.\r\n\r\n<color=yellow>\u0646\u0645\u0627\u06CC
    \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644:</color>\n\u2022 \u062D\u0648\u0627\u0634\u06CC
    \u0645\u0632\u06CC\u0627\u0644\u060C \u062F\u06CC\u0633\u062A\u0627\u0644\u060C
    \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644 \u0634\u0628\u06CC\u0647 \u0633\u0637\u062D
    \u0644\u0628\u06CC\u0627\u0644 \u0627\u0633\u062A.\r\n\u2022 \u0633\u06CC\u0646\u06AF\u0648\u0644\u0648\u0645
    \u0648 \u0645\u0627\u0631\u0698\u06CC\u0646\u0627\u0644 \u0631\u06CC\u062C \u0647\u0627
    \u06A9\u0645\u062A\u0631 \u0628\u0631\u062C\u0633\u062A\u0647 \u0627\u0633\u062A.\r\n\u2022
    H.OFC \u062F\u0631 \u0645\u062D\u0644 \u0633\u06CC\u0646\u06AF\u0648\u0644\u0648\u0645
    \u0648 1/3 \u0633\u0631\u0648\u06CC\u06A9\u0627\u0644 \u0627\u0633\u062A.\r\n\r\n\r<color=yellow>\u0646\u0645\u0627\u06CC
    \u0645\u0632\u06CC\u0627\u0644:</color>\n\u2022 H.OFC \u062F\u0631 1/3 \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644
    \u0627\u0633\u062A \u0648 \u0634\u06A9\u0644 \u0622\u0646 \u0628\u06CC\u0636\u06CC
    \u0627\u0633\u062A.\r\n\u2022 \u0631\u06CC\u062C \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644
    \u0627\u0632 \u0646\u0638\u0631 \u0628\u0627\u06A9\u0648\u0644\u06CC\u0646\u06AF\u0648\u0627\u0644\u06CC
    \u0646\u0627\u0632\u06A9\u062A\u0631 \u0648 \u062F\u0631 \u0646\u062A\u06CC\u062C\u0647
    \u062A\u06CC\u0632\u062A\u0631 \u0627\u0632 \u06A9\u0627\u0646\u06CC\u0646 \u0628\u0627\u0644\u0627
    \u0627\u0633\u062A.\r\n\r\n<color=yellow>\u0646\u0645\u0627\u06CC \u062F\u06CC\u0633\u062A\u0627\u0644:</color>\n\u2022
    H.OFC \u062F\u0631 \u0645\u062D\u0644 \u0627\u062A\u0635\u0627\u0644 1/3 \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644
    \u0648 1/3 \u0648\u0633\u0637 \u0627\u0633\u062A \u0648 \u0628\u0647 \u0639\u0644\u062A
    \u062A\u0645\u0627\u0633 \u0628\u0627 \u067E\u0631\u0645\u0648\u0644\u0631 \u0627\u0648\u0644
    \u0628\u0647 \u0634\u06A9\u0644 \u062F\u0627\u06CC\u0631\u0647 \u0627\u0633\u062A.\r\n\r\n<color=yellow>\u0646\u0645\u0627\u06CC
    \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644:</color>\n\u2022 \u0633\u06CC\u0646\u06AF\u0648\u0644\u0648\u0645
    \u0627\u0646\u062D\u0631\u0627\u0641 \u062F\u06CC\u0633\u062A\u0627\u0644\u06CC
    \u062F\u0627\u0631\u062F.\r\n\r\n<color=yellow>\u0631\u06CC\u0634\u0647:</color>\n\u2022
    \u0627\u06CC\u0646 \u062F\u0646\u062F\u0627\u0646 \u062A\u06A9 \u0631\u06CC\u0634\u0647
    \u0627\u0633\u062A \u0648 \u0627\u0632 \u0628\u0644\u0646\u062F\u062A\u0631\u06CC\u0646
    \u0631\u06CC\u0634\u0647 \u062F\u0646\u062F\u0627\u0646 \u0647\u0627\u06CC \u0641\u06A9
    \u067E\u0627\u06CC\u06CC\u0646 \u0627\u0633\u062A.\r\n\u2022 \u0631\u06CC\u0634\u0647
    \u062F\u0631 \u062C\u0647\u062A \u0645\u0632\u06CC\u0648\u062F\u06CC\u0633\u062A\u0627\u0644
    \u0628\u0627\u0631\u06CC\u06A9 \u0648 \u062F\u0631 \u062C\u0647\u062A \u0644\u0628\u06CC\u0648\u0644\u06CC\u0646\u06AF\u0648\u0627\u0644
    \u0636\u062E\u06CC\u0645 \u0627\u0633\u062A.\r\n\u2022 \u0633\u0637\u062D \u0644\u0628\u06CC\u0627\u0644
    \u0648 \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644 \u0645\u062D\u062F\u0628 \u0627\u0633\u062A
    \u0648 \u062D\u062A\u06CC \u0633\u0637\u062D \u0645\u0632\u06CC\u0627\u0644 \u0648
    \u062F\u06CC\u0633\u062A\u0627\u0644 \u0645\u0642\u0639\u0631 \u0648 \u062F\u0627\u0631\u0627\u06CC
    \u0634\u06CC\u0627\u0631\u0647\u0627\u06CC \u0637\u0648\u0644\u06CC \u0631\u06CC\u0634\u0647
    \u0627\u0633\u062A.\r\n"
