  m_Script: {fileID: 11500000, guid: 02c187b07e47c5a41a6f2ab699b6cdd5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  teethName: 20 - (L) Second Premolar
  teethBio: "\u2022 \u067E\u0646\u062C\u0645\u06CC\u0646 \u062F\u0646\u062F\u0627\u0646
    \u0627\u0632 \u062E\u0637 \u0648\u0633\u0637 \u0627\u0633\u062A \u06A9\u0647 \u062F\u0627\u0631\u0627\u06CC
    \u062A\u0645\u0627\u0633 \u0645\u0632\u06CC\u0627\u0644 \u0628\u0627 \u067E\u0631\u0645\u0648\u0644\u0631
    \u0627\u0648\u0644 \u0648\u062A\u0645\u0627\u0633 \u062F\u06CC\u0633\u062A\u0627\u0644
    \u0628\u0627 \u0645\u0648\u0644\u0631 \u0627\u0648\u0644 \u0627\u0633\u062A.\r\n\u2022
    \u062F\u0631 \u0633\u06CC\u0633\u062A\u0645 \u062C\u0647\u0627\u0646\u06CC \u067E\u0631\u0645\u0648\u0644\u0631
    \u062F\u0648\u0645 \u0686\u067E \u067E\u0627\u06CC\u06CC\u0646 \u0628\u0627 \u0634\u0645\u0627\u0631\u0647
    20 \u0648 \u062F\u0631 \u0633\u06CC\u0633\u062A\u0645 F.D.I \u0628\u0627 \u0634\u0645\u0627\u0631\u0647
    \u06CC 35 \u0645\u0634\u062E\u0635 \u0645\u06CC\u0634\u0648\u062F.\r\n\u2022 \u067E\u0631\u0645\u0648\u0644\u0631
    \u062F\u0648\u0645 \u0628\u0647 \u0637\u0648\u0631 \u06A9\u0644\u06CC \u0628\u0632\u0631\u06AF\u062A\u0631
    \u0627\u0632 \u0645\u0648\u0644\u0631 \u0627\u0648\u0644 \u0627\u0633\u062A \u0648
    \u0646\u0642\u0634 \u0628\u06CC\u0634\u062A\u0631\u06CC \u062F\u0631 \u062C\u0648\u06CC\u062F\u0646
