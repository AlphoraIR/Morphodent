    \u06CC\u06A9 \u0631\u06CC\u0634\u0647 \u06CC  \u0645\u0633\u062A\u0642\u06CC\u0645
    \u062F\u0627\u0631\u062F.\r\n\u2022 \u0627\u0632 \u062F\u06CC\u062F \u0644\u0628\u06CC\u0627\u0644
    \u0648 \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644 \u0642\u0631\u06CC\u0646\u0647
    \u0648 \u0628\u0647 \u0627\u067E\u06A9\u0633 \u062A\u06CC\u0632 \u062E\u062A\u0645
    \u0645\u06CC \u0634\u0648\u062F.\r\n\u2022 \u062F\u0631 \u0628\u0639\u062F \u0645\u0632\u06CC\u0627\u0644
    \u0648 \u062F\u06CC\u0633\u062A\u0627\u0644 \u0627\u0645\u06A9\u0627\u0646 \u062F\u0627\u0631\u062F
