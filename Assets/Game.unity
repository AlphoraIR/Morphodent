  teethName: 25 - (R) Central Incisor
  teethBio: "\u2022 \u062F\u0646\u062F\u0627\u0646 \u0647\u0627\u06CC  \u0627\u06CC\u0646\u0633\u06CC\u0632\u0648\u0631
    \u0645\u0646\u062F\u06CC\u0628\u0644 \u0639\u0645\u0648\u0645\u0627 \u06A9\u0648\u0686\u06A9\u062A\u0631\u06CC\u0646
    \u062F\u0646\u062F\u0627\u0646\u0647\u0627\u06CC  \u062F\u0627\u0626\u0645\u06CC
    \u0627\u0646\u0633\u0627\u0646  \u0647\u0633\u062A\u0646\u062F.\r\n\u2022 \u062F\u0646\u062F\u0627\u0646
    \u0633\u0646\u062A\u0631\u0627\u0644 \u06A9\u0645\u06CC \u0627\u0632 \u0644\u062A\u0631\u0627\u0644
    \u06A9\u0648\u0686\u06A9\u062A\u0631 \u0627\u0633\u062A.\r\n\u2022 \u0627\u0632
    \u0633\u0627\u062F\u0647 \u062A\u0631\u06CC\u0646 \u062F\u0646\u062F\u0627\u0646
    \u0647\u0627\u06CC  \u0627\u0646\u0633\u0627\u0646 \u0647\u0633\u062A\u0646\u062F
    \ \u0648 \u0634\u0628\u0627\u0647\u062A \u0632\u06CC\u0627\u062F\u06CC \u0628\u0647
    \u0647\u0645 \u062F\u0627\u0631\u0646\u062F.\r\n\u2022 \u062F\u0646\u062F\u0627\u0646
    \u0627\u06CC\u0646\u0633\u06CC\u0632\u0648\u0631 \u0633\u0646\u062A\u0631\u0627\u0644
    \u0645\u0646\u062F\u06CC\u0628\u0644 \u0631\u0627\u0633\u062A \u062F\u0631\u0633\u06CC\u0633\u062A\u0645
    \u062C\u0647\u0627\u0646\u06CC  \u0628\u0627 \u0634\u0645\u0627\u0631\u0647 25
    \u0648 \u062F\u0631 \u0633\u06CC\u0633\u062A\u0645  F.D.I\u0628\u0627 \u0634\u0645\u0627\u0631\u0647
    41  \u0645\u0634\u062E\u0635 \u0645\u06CC \u0634\u0648\u062F.\r\n\u2022 \u062F\u0646\u062F\u0627\u0646
    \u0633\u0646\u062A\u0631\u0627\u0644 \u067E\u0627\u06CC\u06CC\u0646 \u0639\u0645\u0648\u0645\u0627
    \u06A9\u0648\u0686\u06A9\u062A\u0631\u06CC\u0646  \u062A\u0627\u062C \u062F\u0646\u062F\u0627\u0646
    \u062F\u0627\u0626\u0645\u06CC \u0631\u0627 \u062F\u0627\u0631\u062F \u0648 \u0648\u0638\u06CC\u0641\u0647
    \u0622\u0646 \u06AF\u0627\u0632 \u06AF\u0631\u0641\u062A\u0646  \u0648 \u0628\u0631\u06CC\u062F\u0646
    \u0627\u0633\u062A \u0648 \u0627\u0648\u0644\u06CC\u0646 \u062F\u0646\u062F\u0627\u0646
    \u0627\u0632 \u062E\u0637 \u0648\u0633\u0637 \u0627\u0633\u062A \u06A9\u0647 \u062F\u0627\u0631\u0627\u06CC
    \u062A\u0645\u0627\u0633 \u0645\u0632\u06CC\u0627\u0644 \u0628\u0627 \u062F\u0646\u062F\u0627\u0646
    \ \u0647\u0645 \u0646\u0627\u0645 \u062E\u0648\u062F \u0627\u0633\u062A.\r\n\r\n<color=yellow>\u0646\u0645\u0627\u06CC
    \u0644\u0628\u06CC\u0627\u0644:</color>\n\u2022 \u0632\u0627\u0648\u06CC\u0647
    \ \u0645\u0632\u06CC\u0648 \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644 \u0642\u0627\u0626\u0645\u0647
    \u0648 \u062A\u06CC\u0632\u062A\u0631 \u0627\u0632 \u062F\u06CC\u06AF\u0631 \u0627\u06CC\u0646\u0633\u06CC\u0632\u0648\u0631
    \u0647\u0627 \u0627\u0633\u062A.\r\n\u2022 \u0645\u0646\u0637\u0642\u0647 \u062A\u0645\u0627\u0633
    \u0645\u0632\u06CC\u0627\u0644\u06CC \u062E\u06CC\u0644\u06CC \u0646\u0632\u062F\u06CC\u06A9
    \u0628\u0647 \u0644\u0628\u0647 \u06CC \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644
    \u0627\u0633\u062A.\r\n\u2022 \u062D\u0627\u0634\u06CC\u0647 \u062F\u06CC\u0633\u062A\u0627\u0644
    \u0647\u0645 \u0632\u0627\u0648\u06CC\u0647 \u062F\u06CC\u0633\u062A\u0648 \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644
    \u0642\u0627\u0626\u0645\u0647 \u0648 \u062A\u06CC\u0632 \u062F\u0627\u0631\u062F.\r\n\u2022
    \u0633\u0637\u062D \u0644\u0628\u06CC\u0627\u0644 \u0627\u0632 \u0647\u0645\u0647
    \u06CC \u062C\u0647\u0627\u062A \u0645\u062D\u062F\u0628 \u0627\u0633\u062A.\r\n\u2022
    H.O.F.C \u0622\u0646 \u062F\u0631 1/3 \u0698\u0646\u0698\u06CC\u0648\u0627\u0644\u06CC
    \u0642\u0631\u0627\u0631 \u062F\u0627\u0631\u062F.\r\n\u2022 \u0645\u0627\u0646\u0646\u062F
    \u0627\u06CC\u0646\u0633\u06CC\u0632\u0648\u0631 \u0647\u0627\u06CC \u0628\u0627\u0644\u0627
    \u062F\u0631 \u0647\u0646\u06AF\u0627\u0645 \u0631\u0634\u062F \u062F\u0627\u0631\u0627\u06CC
    3 \u0645\u0627\u0645\u0644\u0648\u0646 \u0647\u0633\u062A\u0646\u062F.\r\n\u2022
    \u06AF\u0648\u062F\u06CC \u0647\u0627\u06CC \u0637\u0648\u0644\u06CC \u0645\u0632\u06CC\u0648\u0644\u0628\u06CC\u0627\u0644
    \u0648\u062F\u06CC\u0633\u062A\u0648\u0644\u0628\u06CC\u0627\u0644 \u0648\u062C\u0648\u062F
    \u062F\u0627\u0631\u0646\u062F \u0648\u062A\u0627 1/3 \u0698\u0646\u0698\u06CC\u0648\u0627\u0644\u06CC
    \u06A9\u0634\u06CC\u062F\u0647 \u0634\u062F\u0647 \u0627\u0646\u062F.\r\n\u2022
    \u062E\u0637\u0648\u0637 Imbrication \u0648\u062C\u0648\u062F \u0646\u062F\u0627\u0631\u062F.\r\n\r\n<color=yellow>\u0646\u0645\u0627\u06CC
    \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644:</color>\n\u2022 \u062D\u0627\u0634\u06CC\u0647
    \u0645\u0632\u06CC\u0627\u0644 \u0634\u0628\u06CC\u0647 \u0644\u0628\u06CC\u0627\u0644
    \u0627\u0633\u062A \u0648 \u06AF\u0627\u0647\u06CC \u062F\u0631 \u0646\u06CC\u0645\u0647
    \u06CC \u0698\u0646\u0698\u06CC\u0648\u0627\u0644\u06CC \u06A9\u0645\u06CC \u0645\u0642\u0639\u0631
    \u0645\u06CC \u0634\u0648\u062F.\r\n\u2022 \u0632\u0627\u0648\u06CC\u0647 \u0645\u0632\u06CC\u0648\u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644
    \u0642\u0627\u0626\u0645\u0647 \u0627\u0633\u062A.\r\n\u2022 \u062D\u0627\u0634\u06CC\u0647
    \u062F\u06CC\u0633\u062A\u0627\u0644 \u0634\u0628\u06CC\u0647 \u062D\u0627\u0634\u06CC\u0647
    \u0645\u0632\u06CC\u0627\u0644 \u0627\u0633\u062A.\r\n\u2022 \u062D\u0627\u0634\u06CC\u0647
    \u06CC \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644 \u0628\u0647 \u0635\u0648\u0631\u062A
    \u062E\u0637 \u0645\u0633\u062A\u0642\u06CC\u0645 \u0627\u0633\u062A.\r\n\u2022
    \u0633\u0637\u062D \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644 \u0647\u06CC\u0686
    \u0646\u0648\u0639 \u0634\u06CC\u0627\u0631 pit \u0646\u062F\u0627\u0631\u062F.\r\n\u2022
