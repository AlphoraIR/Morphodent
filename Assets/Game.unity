  m_Script: {fileID: 11500000, guid: 02c187b07e47c5a41a6f2ab699b6cdd5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  teethName: 11 - (L) Canine
  teethBio: "\u2022 \u062F\u0646\u062F\u0627\u0646 \u0647\u0627\u06CC \u06A9\u0627\u0646\u06CC\u0646
    \ \u063A\u0627\u0644\u0628\u0627 \u0633\u062A\u0648\u0646 \u0647\u0627\u06CC \u0641\u06A9\u06CC
    \u062F\u0647\u0627\u0646 \u0627\u0646\u0633\u0627\u0646 \u0646\u0627\u0645 \u062F\u0627\u0631\u0646\u062F\u060C
    \u0632\u06CC\u0631\u0627 \u062F\u0631\u0633\u062A \u062F\u0631 \u0645\u0631\u062D\u0644\u0647
    \u06CC \u0627\u0646\u062A\u0642\u0627\u0644\u06CC \u0648 \u0628\u06CC\u0646 \u062F\u0646\u062F\u0627\u0646
    \u0647\u0627\u06CC \u0642\u062F\u0627\u0645\u06CC \u0648 \u062E\u0644\u0641\u06CC
    \u0642\u0631\u0627\u0631 \u062F\u0627\u0631\u0646\u062F.\r\n\u2022 \u06A9\u0627\u0631
    \u0622\u0646\u0647\u0627 \u067E\u0627\u0631\u0647 \u06A9\u0631\u062F\u0646 \u063A\u0630\u0627
    \u0627\u0633\u062A \u0648 \u062F\u0631 \u062A\u06A9\u0644\u0645 \u0648 \u0632\u06CC\u0628\u0627\u06CC\u06CC
    \u0647\u0645 \u0646\u0642\u0634 \u0627\u0633\u0627\u0633\u06CC \u062F\u0627\u0631\u0646\u062F
    \u0648 \u0628\u0647 \u062F\u0646\u062F\u0627\u0646 \u0647\u0627\u06CC \u06A9\u0627\u0633\u067E\u06CC\u062F
    \u0647\u0645 \u0645\u0639\u0631\u0648\u0641 \u0647\u0633\u062A\u0646\u062F.\r\n\u2022
    \u0627\u0632 \u062F\u06CC\u062F \u067E\u0631\u0648\u06AF\u0632\u06CC\u0645\u0627\u0644
    \u0634\u0628\u06CC\u0647 \u0627\u06CC\u0646\u0633\u06CC\u0632\u0648\u0631\u0647\u0627
    \u0648 \u0645\u062B\u0644\u062B\u06CC \u0634\u06A9\u0644 \u0647\u0633\u062A\u0646\u062F
    \u0648 \u0627\u0632 \u062F\u06CC\u062F \u0644\u0628\u06CC\u0627\u0644 \u0634\u0628\u06CC\u0647
    \u062F\u0646\u062F\u0627\u0646 \u0647\u0627\u06CC \u067E\u0631\u0645\u0648\u0644\u0631
    \u0627\u0633\u062A.\r\n\u2022 \u06A9\u0627\u0646\u06CC\u0646 \u0647\u0627 \u0628\u0644\u0646\u062F\u062A\u0631\u06CC\u0646
    \u062F\u0646\u062F\u0627\u0646 \u0627\u0646\u0633\u0627\u0646 \u0647\u0633\u062A\u0646\u062F
    \u0648 \u0645\u062D\u06A9\u0645 \u062A\u0631\u06CC\u0646 \u062F\u0646\u062F\u0627\u0646
    \u0627\u0646\u0633\u0627\u0646 \u0646\u06CC\u0632 \u0647\u0633\u062A\u0646\u062F
    \u0648 \u062F\u0627\u0631\u0627\u06CC \u0628\u0644\u0646\u062F\u062A\u0631\u06CC\u0646
    \u0631\u06CC\u0634\u0647 \u0647\u0633\u062A\u0646\u062F.\r\n\u2022 \u062F\u0646\u062F\u0627\u0646
    \u06A9\u0627\u0646\u06CC\u0646 \u0686\u067E \u0645\u0627\u06AF\u0632\u06CC\u0644\u0627
    \u0633\u0648\u0645\u06CC\u0646 \u062F\u0646\u062F\u0627\u0646 \u0627\u0632 \u062E\u0637
    \u0648\u0633\u0637 \u0627\u0633\u062A \u06A9\u0647 \u062C\u0627\u0646\u0634\u06CC\u0646
    \u06A9\u0627\u0646\u06CC\u0646 \u0634\u06CC\u0631\u06CC \u0645\u06CC\u0634\u0648\u062F
    \u0648 \u062F\u0627\u0631\u0627\u06CC \u062A\u0645\u0627\u0633 \u0645\u0632\u06CC\u0627\u0644
    \u0628\u0627 \u062F\u0646\u062F\u0627\u0646 \u062F\u06CC\u0633\u062A\u0627\u0644
    \u0648 \u062A\u0645\u0627\u0633 \u062F\u06CC\u0633\u062A\u0627\u0644 \u0628\u0627
    \u067E\u0631\u0645\u0648\u0644\u0631 \u0627\u0648\u0644 \u0645\u0627\u06AF\u0632\u06CC\u0644\u0627
    \u0627\u0633\u062A. \r\n\u2022 \u062F\u0631 \u0633\u06CC\u0633\u062A\u0645 \u062C\u0647\u0627\u0646\u06CC
    \u0628\u0627 \u0634\u0645\u0627\u0631\u0647 \u06CC 11 \u0648 \u062F\u0631 \u0633\u06CC\u0633\u062A\u0645
    F.D.I \u0628\u0627 \u0634\u0645\u0627\u0631\u0647  \u06CC 23 \u0645\u0634\u062E\u0635
    \u0645\u06CC\u0634\u0648\u062F.\r\n\r\n<color=yellow>\u0646\u0645\u0627\u06CC
    \u0644\u0628\u06CC\u0627\u0644:</color>\n\u2022 \u0634\u06A9\u0644 \u0647\u0646\u062F\u0633\u06CC
    \u0622\u0646 5 \u0636\u0644\u0639\u06CC \u0627\u0633\u062A \u0648 \u0627\u0632
    \u0647\u0645\u0647 \u0646\u0638\u0631 \u0645\u062D\u062F\u0628 \u0627\u0633\u062A.\r\n\u2022
    H.OFC \u0644\u0628\u0647 \u06CC \u0645\u0632\u06CC\u0627\u0644 \u062F\u0631 \u0645\u062D\u0644
    \u0627\u062A\u0635\u0627\u0644 1/3 \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644
    \u0648 1/3 \u0648\u0633\u0637 \u0627\u0633\u062A.\r\n\u2022 \u062D\u0627\u0634\u06CC\u0647
    \u062F\u06CC\u0633\u062A\u0627\u0644 \u06A9\u0648\u062A\u0627\u0647 \u062A\u0631
    \u0627\u0632 \u0645\u0632\u06CC\u0627\u0644 \u0627\u0633\u062A \u0648 \u0645\u0639\u0645\u0648\u0644\u0627
    \u0645\u0642\u0639\u0631 \u0627\u0633\u062A\u060C H.OFC \u062F\u0631 \u0645\u0646\u0637\u0642\u0647
    \u062A\u0645\u0627\u0633 \u0648 \u062F\u0631 1/3 \u0648\u0633\u0637 \u0627\u0633\u062A.\r\n\u2022
    \u062D\u0627\u0634\u06CC\u0647 \u06CC \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644
    \u0628\u0648\u0633\u06CC\u0644\u0647 \u06CC \u0631\u0627\u0633 \u06A9\u0627\u0633\u067E
    \u0628\u0647 \u062F\u0648 \u0634\u06CC\u0628 \u0645\u0632\u06CC\u0627\u0644 \u0648
    \u062F\u06CC\u0633\u062A\u0627\u0644 \u062A\u0642\u0633\u06CC\u0645 \u0645\u06CC\u0634\u0648\u062F\u060C
    \u0634\u06CC\u0628 \u0645\u0632\u06CC\u0648 \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644
    \u0628\u0644\u0646\u062F \u062A\u0631 \u0627\u0632 \u0634\u06CC\u0628 \u062F\u06CC\u0633\u062A\u0648
    \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644 \u0627\u0633\u062A.\r\n\u2022
    \u0633\u0637\u062D \u0644\u0628\u06CC\u0627\u0644 \u062F\u0627\u0631\u0627\u06CC
    \u0631\u06CC\u062C \u0644\u0628\u06CC\u0627\u0644 \u0627\u0633\u062A \u06A9\u0647
    \u062F\u0631 \u062C\u0647\u062A \u0627\u06CC\u0646\u0633\u06CC\u0632\u0648 \u0698\u0646\u0698\u06CC\u0648\u0627\u0644
    \u06A9\u0634\u06CC\u062F\u0647 \u0634\u062F\u0647 \u0627\u0633\u062A.\r\n\u2022
    \u062F\u0627\u0631\u0627 \u06CC \u062F\u0648 \u06AF\u0648\u062F\u06CC \u0631\u0634\u062F\u06CC
    \u0637\u0648\u0644\u06CC \u0645\u0632\u06CC\u0648\u0644\u0628\u06CC\u0627\u0644
    \u0648 \u062F\u06CC\u0633\u062A\u0648\u0644\u0628\u06CC\u0627\u0644 \u0627\u0633\u062A.\r\n\u2022
    \u062F\u0631 \u062D\u0627\u0634\u06CC\u0647 \u06CC \u0698\u06CC\u0646\u0698\u06CC\u0648\u0627\u0644
    \u062E\u0637\u0648\u0637 \u0639\u0631\u0636\u06CC \u0627\u06CC\u0645\u0628\u0631\u06CC\u06A9\u06CC\u0634\u0646
    \u062F\u06CC\u062F\u0647 \u0645\u06CC\u0634\u0648\u062F.\r\n\u2022 H.OFC \u0646\u0645\u0627\u06CC
    \u0644\u0628\u06CC\u0627\u0644 \u062F\u0631 1/3 \u0633\u0631\u0648\u06CC\u06A9\u0627\u0644
    \u0627\u0633\u062A.\r\n            \r\n<color=yellow>\u0646\u0645\u0627\u06CC
    \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644:</color>\n\u2022 \u062D\u0627\u0634\u06CC\u0647
    \u06CC \u0645\u0632\u06CC\u0627\u0644 \u0648 \u062F\u06CC\u0633\u062A\u0627\u0644
    \u0648 \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644 \u0634\u0628\u06CC\u0647
    \u0633\u0637\u062D \u0644\u0628\u06CC\u0627\u0644 \u0627\u0633\u062A.\r\n\u2022
    \u0639\u0631\u0636 \u0645\u0632\u06CC\u0648 \u062F\u06CC\u0633\u062A\u0627\u0644
    \u0627\u06CC\u0646 \u0633\u0637\u062D \u06A9\u0645\u062A\u0631 \u0627\u0632 \u0644\u0628\u06CC\u0627\u0644
    \u0627\u0633\u062A.\r\n\u2022 \u0633\u06CC\u0646\u06AF\u0648\u0644\u0648\u0645
    \u0628\u0633\u06CC\u0627\u0631 \u0628\u0631\u062C\u0633\u062A\u0647 \u0627\u0633\u062A
    \u0648\u0644\u06CC \u0635\u0627\u0641 \u0627\u0633\u062A \u0648 \u0645\u0627\u0631\u0698\u06CC\u0646\u0627\u0644
    \u0631\u06CC\u062C \u0647\u0627 \u062F\u0631 \u0645\u0642\u0627\u06CC\u0633\u0647
    \u0628\u0627 \u0633\u0627\u0646\u062A\u0631\u0627\u0644 \u0628\u0631\u062C\u0633\u062A\u06AF\u06CC
    \u0628\u06CC\u0634\u062A\u0631\u06CC \u062F\u0627\u0631\u0646\u062F\r\n\u2022
    \u062F\u0627\u0631\u0627\u06CC \u0631\u06CC\u062C \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644
    \u0627\u0633\u062A \u0648 \u0628\u06CC\u0646 \u0631\u06CC\u062C \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644
    \u0648 \u062F\u0648 \u0645\u0627\u0631\u0698\u06CC\u0646\u0627\u0644 \u0631\u06CC\u062C
    \u0645\u0632\u06CC\u0627\u0644 \u0648 \u062F\u06CC\u0633\u062A\u0627\u0644 \u060C\u062F\u0648
    \u0641\u0648\u0633\u0627\u06CC \u06A9\u0645 \u0639\u0645\u0642 \u0628\u0647 \u0646\u0627\u0645
    \u0641\u0648\u0633\u0627\u06CC \u0645\u0632\u06CC\u0648\u0644\u06CC\u0646\u06AF\u0648\u0627\u0644
    \u0648 \u062F\u06CC\u0633\u062A\u0648\u0644\u06CC\u0646\u06AF\u0648\u0627\u0644
    \u062A\u0634\u06A9\u06CC\u0644 \u0645\u06CC\u0634\u0648\u062F.\r\n\u2022 H.OFC
    \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644 \u062F\u0631 \u062D\u062F\u0627\u06A9\u062B\u0631
    \u062A\u062D\u062F\u0628 \u0633\u06CC\u0646\u06AF\u0648\u0644\u0648\u0645 \u062F\u0631
    1/3 \u0633\u0631\u0648\u06CC\u06A9\u0627\u0644 \u0627\u0633\u062A.\r\n\r\n<color=yellow>\u0646\u0645\u0627\u06CC
    \u0645\u0632\u06CC\u0627\u0644:</color>\n\u2022 \u0646\u0645\u0627\u06CC \u0645\u0632\u06CC\u0627\u0644
    \u0645\u062B\u0644\u062B\u06CC \u0634\u06A9\u0644 \u0627\u0633\u062A \u0648 \u0627\u0632
    \u0646\u0638\u0631 \u0644\u0628\u06CC\u0648\u0644\u06CC\u0646\u06AF\u0648\u0627\u0644\u06CC
    \u067E\u0647\u0646 \u062A\u0631 \u0627\u0632\u0627\u06CC\u0646\u0633\u06CC\u0632\u0648\u0631\u0647\u0627
    \ \u0627\u0633\u062A.\r\n\u2022 H.OFC \u0645\u0632\u06CC\u0627\u0644 \u062F\u0631
    \u0645\u0646\u0637\u0642\u0647 \u062A\u0645\u0627\u0633 \u0648 \u062F\u0631 \u0645\u062D\u0644
    \u0627\u062A\u0635\u0627\u0644 1/3 \u0648\u0633\u0637 \u0648 1/3 \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644
    \u0627\u0633\u062A.\r\n\r\n<color=yellow>\u0646\u0645\u0627\u06CC \u062F\u06CC\u0633\u062A\u0627\u0644:</color>\n\u2022
    \u0627\u06CC\u0646 \u0646\u0645\u0627 \u0634\u0628\u06CC\u0647 \u0646\u0645\u0627\u06CC
    \u0645\u0632\u06CC\u0627\u0644 \u0627\u0633\u062A.\u0641\u0642\u0637 \u06A9\u0648\u0686\u06A9\u062A\u0631
    \u0648 \u06A9\u0648\u062A\u0627\u0647 \u062A\u0631 \u0627\u0633\u062A.\r\n\u2022
    C.E.J \u0642\u0648\u0633 \u06A9\u0645\u062A\u0631\u06CC \u0646\u0633\u0628\u062A
    \u0628\u0647 \u0645\u0632\u06CC\u0627\u0644 \u062F\u0627\u0631\u062F.\r\n\u2022
    H.OFC \u062F\u0631 \u0645\u0646\u0637\u0642\u0647 \u062A\u0645\u0627\u0633 \u0648
    \u062F\u0631 1/3 \u0648\u0633\u0637 \u0627\u0633\u062A.\r\n\r\n<color=yellow>\u0646\u0645\u0627\u06CC
    \u0627\u06CC\u0646\u0633\u06CC\u0632\u0627\u0644:</color>\n\u2022 \u0628\u0647
    \u0637\u0648\u0631 \u06A9\u0644\u06CC \u0627\u06CC\u0646 \u0646\u0645\u0627 \u0645\u062D\u062F\u0628
    \u0627\u0633\u062A\u060C \u0636\u062E\u0627\u0645\u062A \u0644\u0628\u06CC\u0648\u0644\u06CC\u0646\u06AF\u0648\u0627\u0644\u06CC
    \u0622\u0646 \u0628\u06CC\u0634\u062A\u0631 \u0627\u0632 \u0633\u0646\u062A\u0631\u0627\u0644
    \u0627\u0633\u062A.\r\n\u2022 \u0646\u06CC\u0645\u0647 \u0645\u0632\u06CC\u0627\u0644\u06CC
    \u0636\u062E\u06CC\u0645 \u062A\u0631 \u0648 \u0645\u062D\u062F\u0628 \u062A\u0631
    \u0627\u0632 \u0646\u06CC\u0645\u0647 \u06CC \u062F\u06CC\u0633\u062A\u0627\u0644\u06CC
    \u0627\u0633\u062A.\r\n\r\n<color=yellow>\u0631\u06CC\u0634\u0647:</color>\n\u2022
    \u0627\u06CC\u0646 \u062F\u0646\u062F\u0627\u0646 \u062A\u06A9 \u0631\u06CC\u0634\u0647
    \u0627\u0633\u062A \u0648 \u0628\u0644\u0646\u062F \u062A\u0631\u06CC\u0646 \u0631\u06CC\u0634\u0647
    \u0631\u0627 \u0628\u06CC\u0646 \u062F\u0646\u062F\u0627\u0646\u0647\u0627 \u062F\u0627\u0631\u062F.\r\n\u2022
    \u0631\u06CC\u0634\u0647 \u0645\u062E\u0631\u0648\u0637\u06CC \u0634\u06A9\u0644
    \u0627\u0633\u062A \u0648 \u0627\u067E\u06A9\u0633 \u062A\u06CC\u0632\u06CC \u062F\u0627\u0631\u062F.\r\n\u2022
    \u0631\u06CC\u0634\u0647 \u062F\u0631 \u0628\u0639\u062F \u0644\u0628\u06CC\u0648
    \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644 \u067E\u0647\u0646 \u062A\u0631 \u0627\u0632
