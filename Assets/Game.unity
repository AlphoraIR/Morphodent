    \u0627\u0633\u062A\n\r\n\u0645\u0648\u0631\u0641\u0648\u062F\u0646\u062A \u0647\u0645
    \u0627\u0648\u0644 \u06CC\u06A9 \u0627\u062D\u0633\u0627\u0633 \u0646\u06CC\u0627\u0632
    \u0628\u0648\u062F \u06A9\u0647 \u062A\u0628\u062F\u06CC\u0644 \u0628\u0647 \u06CC\u06A9
    \u0627\u06CC\u062F\u0647 \u06CC \u0639\u0645\u0644\u06CC \u0634\u062F\n\r\n\u0647\u06CC\u0686
    \u06A9\u0627\u0631\u06CC \u0628\u062F\u0648\u0646 \u06A9\u0627\u0633\u062A\u06CC
    \u0646\u06CC\u0633\u062A\n\u0645\u0646\u062A\u0638\u0631 \u0627\u0646\u062A\u0642\u0627\u062F\u0627\u062A
