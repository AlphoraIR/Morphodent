    \u0627\u06CC\u0646 \u062D\u0627\u0634\u06CC\u0647 \u06A9\u0645\u062A\u0631 \u0627\u0633\u062A.\r\n\u2022
    \u0639\u0645\u0642 C.E.J \u06A9\u0645\u062A\u0631 \u0627\u0632 \u062F\u0646\u062F\u0627\u0646
