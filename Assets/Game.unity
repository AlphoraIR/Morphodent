--- !u!114 &1579075988
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 1579075986}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 02c187b07e47c5a41a6f2ab699b6cdd5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  teethName: 13 - (L) Second Premolar
  teethBio: "\u2022 \u067E\u0646\u062C\u0645\u06CC\u0646 \u062F\u0646\u062F\u0627\u0646
    \u0627\u0632 \u062E\u0637 \u0648\u0633\u0637 \u0627\u0633\u062A \u06A9\u0647 \u062F\u0627\u0631\u0627\u06CC
    \u062A\u0645\u0627\u0633 \u0645\u0632\u06CC\u0627\u0644 \u0628\u0627 \u067E\u0631\u0645\u0648\u0644\u0631
    \u0627\u0648\u0644 \u0648 \u062A\u0645\u0627\u0633 \u062F\u06CC\u0633\u062A\u0627\u0644
    \u0628\u0627 \u0645\u0648\u0644\u0631 \u0627\u0648\u0644 \u062F\u0627\u0626\u0645\u06CC
    \u0628\u0627\u0644\u0627 \u0627\u0633\u062A.\r\n\u2022 \u062F\u0631 \u0633\u06CC\u0633\u062A\u0645
    \u06CC\u0648\u0646\u06CC\u0648\u0631 \u0633\u0627\u0644 \u067E\u0631\u0645\u0648\u0644\u0631
    \u062F\u0648\u0645 \u0686\u067E \u0628\u0627\u0644\u0627 \u0628\u0627 \u0634\u0645\u0627\u0631\u0647
    13 \u0648 \u062F\u0631 \u0633\u06CC\u0633\u062A\u0645 F.D.I \u0628\u0627 \u0634\u0645\u0627\u0631\u0647
    25 \u0645\u0634\u062E\u0635 \u0645\u06CC\u0634\u0648\u062F.\r\n\r\n\u2022 \u0627\u0632
    \u0646\u0638\u0631 \u0641\u0631\u0645 \u0648 \u0641\u0646\u06A9\u0634\u0646 \u0634\u0628\u06CC\u0647
    \u067E\u0631\u0645\u0648\u0644\u0631 \u0627\u0648\u0644 \u0627\u0633\u062A \u0628\u0647
    \u062C\u0632:\r\n11. \u067E\u0631\u0645\u0648\u0644\u0631 \u062F\u0648\u0645 \u0628\u0647
    \u0637\u0648\u0631 \u06A9\u0644\u06CC \u06A9\u0648\u0686\u06CC\u06A9\u062A\u0631
    \u0627\u0633\u062A \u0648 \u062F\u0631 \u062A\u0645\u0627\u0645 \u0627\u0628\u0639\u0627\u062F
    \u06AF\u0631\u062F \u0634\u062F\u0647 \u062A\u0631 \u0627\u0633\u062A.\r\n12.
    \u0646\u0633\u0628\u062A \u0628\u0647 \u067E\u0631\u0647 \u0645\u0648\u0644\u0631
    \u0627\u0648\u0644 \u062A\u0646\u0648\u0639 \u0628\u06CC\u0634\u062A\u0631\u06CC
    \u062F\u0627\u0631\u06CC\u062F.\r\n13. \u06A9\u0627\u0633\u067E\u0647\u0627\u06CC
    \u0628\u0627\u06A9\u0627\u0644 \u0648 \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644
    \u0622\u0646 \u062A\u0642\u0631\u06CC\u0628\u0627 \u0647\u0645 \u0627\u0631\u062A\u0641\u0627\u0639
    \u0627\u0633\u062A.\r\n14. \u062F\u0631 \u0633\u0637\u062D \u0645\u0632\u06CC\u0627\u0644
    \u062A\u0627\u062C \u0645\u0639\u0645\u0648\u0644\u0627 \u062A\u0642\u0639\u0631
    \u062F\u06CC\u062F\u0647 \u0646\u0645\u06CC\u0634\u0648\u062F.\r\n15. \u0627\u06CC\u0646
    \u062F\u0646\u062F\u0627\u0646 \u062A\u06A9 \u0631\u06CC\u0634\u0647 \u0627\u06CC
    \u0627\u0633\u062A.\r\n16. \u062F\u0631 \u0646\u0645\u0627\u06CC \u0628\u0627\u06A9\u0627\u0644
    \u0634\u06CC\u0628 \u0645\u0632\u06CC\u0627\u0644 \u062D\u0627\u0634\u06CC\u0647
    \u0627\u06A9\u0644\u0648\u0632\u0627\u0644 \u06A9\u0648\u062A\u0627\u0647\u062A\u0631
    \u0627\u0632 \u0634\u06CC\u0628 \u062F\u06CC\u0633\u062A\u0627\u0644 \u0627\u0633\u062A.\r\n17.
    \u0631\u0627\u0633 \u06A9\u0627\u0633\u067E \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644
    \u0628\u0647 \u0633\u0645\u062A \u0645\u0632\u06CC\u0627\u0644 \u0627\u0646\u062D\u0631\u0627\u0641
    \u0646\u062F\u0627\u0631\u062F.\r\n18. \u0634\u06CC\u0627\u0631 \u0645\u0627\u0631\u0698\u06CC\u0646\u0627\u0644
    \u0645\u0632\u06CC\u0627\u0644 \u062F\u06CC\u062F\u0647 \u0646\u0645\u06CC\u0634\u0648\u062F.\r\n19.
    \u062F\u0631 \u0633\u0637\u062D \u0645\u0632\u06CC\u0627\u0644 \u0631\u06CC\u0634\u0647
    \u062A\u0642\u0639\u0631\u06CC \u0648\u062C\u0648\u062F \u0646\u062F\u0627\u0631\u062F.\r\n20.
    \u0627\u0632 \u062F\u06CC\u062F \u0627\u06A9\u0644\u0648\u0632\u0627\u0644 \u062A\u0642\u0631\u06CC\u0628\u0627
    \u0628\u06CC\u0636\u06CC \u0634\u06A9\u0644 \u0627\u0633\u062A \u0648 \u0632\u0648\u0627\u06CC\u0627
    \u06AF\u0631\u062F \u0634\u062F\u0647 \u0627\u0633\u062A.\r\n"
