--- !u!114 &591090598
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 591090596}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 02c187b07e47c5a41a6f2ab699b6cdd5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  teethName: 2 - (R) Second Molar
  teethBio: "\u2022 \u0645\u0648\u0644\u0631 \u062F\u0648\u0645\u060C \u0647\u0641\u062A\u0645\u06CC\u0646
    \u062F\u0646\u062F\u0627\u0646 \u0627\u0632 \u062E\u0637 \u0648\u0633\u0637 \u0627\u0633\u062A
    \u06A9\u0647 \u062F\u0627\u0631\u0627\u06CC \u062A\u0645\u0627\u0633 \u0645\u0632\u06CC\u0627\u0644
    \u0628\u0627 \u0645\u0648\u0644\u0631 \u0627\u0648\u0644 \u0648 \u062A\u0645\u0627\u0633
    \u062F\u06CC\u0633\u062A\u0627\u0644 \u0628\u0627 \u0645\u0648\u0644\u0631 \u0633\u0648\u0645
    \u0627\u0633\u062A.\r\n\u2022 \u0627\u06CC\u0646 \u062F\u0646\u062F\u0627\u0646\u060C
    \u062F\u0646\u062F\u0627\u0646 \u062C\u0627\u0646\u0634\u06CC\u0646 \u0645\u062D\u0633\u0648\u0628
    \u0646\u0645\u06CC \u0634\u0648\u062F.\r\n\u2022 \u062F\u0631 \u0633\u06CC\u0633\u062A\u0645
    \u06CC\u0648\u0646\u06CC\u0648\u0631\u0633\u0627\u0644 \u0645\u0648\u0644\u0631
    \u062F\u0648\u0645 \u0631\u0627\u0633\u062A \u0628\u0627\u0644\u0627 \u0628\u0627
    \u0634\u0645\u0627\u0631\u0647 2 \u0648 \u062F\u0631 \u0633\u06CC\u0633\u062A\u0645
    F.D.I \u0628\u0647 \u0634\u0645\u0627\u0631\u0647 17 \u0645\u0634\u062E\u0635
    \u0645\u06CC\u0634\u0648\u062F.\r\n\u2022 \u0641\u0646\u06A9\u0634\u0646 \u0645\u0648\u0644\u0631
    \u062F\u0648\u0645 \u0645\u0627\u0646\u0646\u062F \u0645\u0648\u0644\u0631 \u0627\u0648\u0644
    \u062C\u0648\u06CC\u062F\u0646 \u0627\u0633\u062A.\r\n\u2022 \u062A\u0627\u062C
    \u062F\u0646\u062F\u0627\u0646 \u0634\u0628\u06CC\u0647 \u0645\u0648\u0644\u0631
    \u0627\u0648\u0644 \u0627\u0633\u062A\u060C \u0628\u0647 \u0637\u0648\u0631 \u06A9\u0644\u06CC
    \u06A9\u0645\u06CC \u06A9\u0648\u0686\u06A9\u062A\u0631 \u0627\u0633\u062A.\r\n\u2022
    \u0631\u06CC\u0634\u0647 \u0647\u0627\u06CC \u0627\u06CC\u0646 \u062F\u0646\u062F\u0627\u0646
    \ \u0628\u0647 \u0647\u0645\u0627\u0646 \u0628\u0644\u0646\u062F\u06CC \u0645\u0648\u0644\u0631
    \u0627\u0648\u0644 \u0648 \u06AF\u0627\u0647\u06CC \u0628\u0644\u0646\u062F \u062A\u0631
    \u0627\u0632 \u0645\u0648\u0644\u0631 \u0627\u0648\u0644 \u0627\u0633\u062A.\r\n\r\n\u2022
    \u062A\u0641\u0627\u0648\u062A \u0647\u0627 \u0628\u0627 \u0645\u0648\u0644\u0631
    \u0627\u0648\u0644:\r\n1. \u0634\u06CC\u0627\u0631 \u0628\u0627\u06A9\u0627\u0644
    \u062F\u06CC\u0633\u062A\u0627\u0644 \u062A\u0631 \u0627\u0633\u062A \u0648 \u062F\u0631
    \u0646\u062A\u06CC\u062C\u0647 \u06A9\u0627\u0633\u067E \u0645\u0632\u06CC\u0648
    \u0628\u0627\u06A9\u0627\u0644 \u0628\u0632\u0631\u06AF\u062A\u0631 \u0627\u0633\u062A
    \u0648\u06A9\u0627\u0633\u067E \u062F\u06CC\u0633\u062A\u0648 \u0628\u0627\u06A9\u0627\u0644
    \u062A\u06CC\u0632 \u062A\u0631 \u0648 \u06A9\u0648\u0686\u06A9\u062A\u0631 \u060C
    \u0647\u0631 \u062F\u0648 \u06A9\u0627\u0633\u067E \u0647\u0645 \u0627\u0631\u062A\u0641\u0627\u0639
    \u0647\u0633\u062A\u0646\u062F.\r\n2. \u06A9\u0627\u0633\u067E \u062F\u06CC\u0633\u062A\u0648
    \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644 \u0627\u0632 \u0646\u0638\u0631 \u0627\u0646\u062F\u0627\u0632\u0647
    \u0648 \u0627\u0631\u062A\u0641\u0627\u0639 \u062E\u06CC\u0644\u06CC \u06A9\u0648\u0686\u06A9\u062A\u0631
    \u0627\u0632 \u0627\u06CC\u0646 \u06A9\u0627\u0633\u067E \u0645\u0648\u0644\u0631
    \u0627\u0648\u0644 \u0627\u0633\u062A.\r\n3. \u06A9\u0627\u0633\u067E \u06A9\u0627\u0631\u0627\u0628\u0644\u06CC
    \u0648\u062C\u0648\u062F \u0646\u062F\u0627\u0631\u062F\r\n4. \u0634\u06CC\u0627\u0631
    \u062F\u06CC\u0633\u062A\u0648 \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644 \u0637\u0648\u0644
    \u0686\u0646\u062F\u0627\u0646\u06CC \u0646\u062F\u0627\u0631\u062F \u0648 \u062F\u0631
    1/3 \u0627\u06A9\u0644\u0648\u0632\u0627\u0644\u06CC \u0645\u062D\u0648 \u0645\u06CC\u0634\u0648\u062F.\r\n5.
    \u062F\u0631\u0646\u0645\u0627\u06CC \u0645\u0632\u06CC\u0627\u0644 \u0646\u06CC\u0645\u0647
    \u06CC \u0633\u0631\u0648\u06CC\u06A9\u0627\u0644\u06CC \u062F\u0646\u062F\u0627\u0646
    \u062F\u0627\u0631\u0627\u06CC \u062A\u0642\u0639\u0631 \u0646\u06CC\u0633\u062A.\r\n6.
    \u063A\u0627\u0628\u0644\u0627 \u0634\u06CC\u0627\u0631 \u0647\u0627\u06CC \u062B\u0627\u0646\u0648\u06CC
    \u0632\u06CC\u0627\u062F\u062A\u0631\u06CC \u062F\u0631 \u0627\u06CC\u0646 \u062F\u0646\u062F\u0627\u0646
    \u0648\u062C\u0648\u062F \u062F\u0627\u0631\u062F.\r\n"
