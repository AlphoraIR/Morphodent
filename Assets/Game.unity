--- !u!114 &1292372424
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 114831687737215186, guid: b821a0df3d487db49b1bcc7661a836ae,
    type: 2}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 1292372421}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 02c187b07e47c5a41a6f2ab699b6cdd5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  teethName: 18 - (L) Second Molar
  teethBio: "\u2022 \u0645\u0648\u0644\u0631 \u062F\u0648\u0645 \u067E\u0627\u06CC\u06CC\u0646
    \u0647\u0641\u062A\u0645\u06CC\u0646 \u062F\u0646\u062F\u0627\u0646 \u0627\u0632
    \u062E\u0637 \u0648\u0633\u0637 \u0627\u0633\u062A \u06A9\u0647 \u062F\u0627\u0631\u0627\u06CC
    \u062A\u0645\u0627\u0633 \u0645\u0632\u06CC\u0627\u0644 \u0628\u0627 \u0645\u0648\u0644\u0631
    \u0627\u0648\u0644 \u062F\u0627\u0626\u0645\u06CC \u0648 \u062A\u0645\u0627\u0633
    \u062F\u06CC\u0633\u062A\u0627\u0644 \u0628\u0627 \u0645\u0648\u0644\u0631 \u0633\u0648\u0645
    \u0627\u0633\u062A.\r\n\u2022 \u0686\u0648\u0646 \u062F\u0631 \u0633\u0646 12
    \u0633\u0627\u0644\u06AF\u06CC \u0631\u0648\u06CC\u0634 \u067E\u06CC\u062F\u0627
    \u0645\u06CC \u06A9\u0646\u062F \u0628\u0647 \u0622\u0646 \u062F\u0646\u062F\u0627\u0646
    12 \u0633\u0627\u0644\u06AF\u06CC \u06AF\u0641\u062A\u0647 \u0645\u06CC\u0634\u0648\u062F.\r\n\u2022
    \u062F\u0631 \u0633\u06CC\u0633\u062A\u0645 \u062C\u0647\u0627\u0646\u06CC \u0645\u0648\u0644\u0631
    \u062F\u0648\u0645 \u0686\u067E \u067E\u0627\u06CC\u06CC\u0646 \u0628\u0627 \u0634\u0645\u0627\u0631\u0647
    18 \u0648 \u062F\u0631 \u0633\u06CC\u0633\u062A\u0645 F.D.I \u0628\u0627 \u0634\u0645\u0627\u0631\u0647
    37 \u0645\u0634\u062E\u0635 \u0645\u06CC\u0634\u0648\u062F.\r\n\u2022 \u0641\u0646\u06A9\u0634\u0646
    \u0622\u0646 \u062F\u0631 \u0639\u0645\u0644 \u062C\u0648\u06CC\u062F\u0646 \u0627\u0633\u062A.\r\n\r\n\u2022
    \u0634\u06A9\u0644 \u0622\u0646 \u0634\u0628\u06CC\u0647 \u0645\u0648\u0644\u0631
    \u0627\u0648\u0644 \u0627\u0633\u062A \u0628\u0627 \u0627\u06CC\u0646 \u062A\u0641\u0627\u0648\u062A
    \u06A9\u0647 :\r\n1. \u0628\u0647 \u0637\u0648\u0631 \u06A9\u0644\u06CC \u062F\u0631
    \u062A\u0645\u0627\u0645 \u0627\u0628\u0639\u0627\u062F \u06A9\u0648\u0686\u06A9
    \u062A\u0631\u06CC\u0646 \u0648 \u0642\u0631\u06CC\u0646\u0647 \u062A\u0631 \u0627\u0633\u062A.\r\n2.
    \u0627\u0632 \u0646\u0638\u0631 \u0633\u0637\u062D \u0627\u06A9\u0644\u0648\u0632\u0627\u0644
    \u0633\u0627\u062F\u0647 \u062A\u0631\u06CC\u0646 \u0645\u0648\u0644\u0631 \u0627\u0633\u062A.\r\n3.
    \u062F\u0627\u0631\u0627\u06CC 4\u06A9\u0627\u0633\u067E \u0627\u0633\u062A \u0648
    \u0634\u06CC\u0627\u0631 \u062F\u06CC\u0633\u062A\u0648 \u0628\u0627\u06A9\u0627\u0644
    \u0648 \u06A9\u0627\u0633\u067E \u062F\u06CC\u0633\u062A\u0627\u0644 \u062F\u0631
    \u0622\u0646 \u0648\u062C\u0648\u062F \u0646\u062F\u0627\u0631\u062F.\r\n\r\n<color=yellow>\u0646\u0645\u0627\u06CC
    \u0628\u0627\u06A9\u0627\u0644:</color>\n\u2022 \u0646\u0645\u0627\u06CC \u0628\u0627\u06A9\u0627\u0644
    \u0628\u0647 \u0648\u0633\u06CC\u0644\u0647 \u0634\u06CC\u0627\u0631 \u0631\u0634\u062F\u06CC
    \u0628\u0627\u06A9\u0627\u0644 \u0628\u0647 \u062F\u0648 \u0642\u0633\u0645\u062A
    \u0646\u0633\u0628\u062A\u0627 \u0645\u0633\u0627\u0648\u06CC \u062A\u0642\u0633\u06CC\u0645
    \u0634\u062F\u0647 \u0627\u0633\u062A.\r\n\u2022 \u0634\u06CC\u0627\u0631 \u062F\u06CC\u0633\u062A\u0648
    \u0628\u0627\u06A9\u0627\u0644 \u0648\u062C\u0648\u062F \u0646\u062F\u0627\u0631\u062F.\r\n\u2022
    H.OFC \u062F\u0631 1/3 \u0633\u0631\u0648\u06CC\u06A9\u0627\u0644 \u0627\u0633\u062A.\r\n\u2022
    \u0645\u0639\u0645\u0648\u0644\u0627 \u062A\u0642\u0639\u0631 \u0645\u0632\u06CC\u0648
    \u062F\u06CC\u0633\u062A\u0627\u0644\u06CC \u0627\u0641\u0642\u06CC \u062F\u0631
    1/3 \u0648\u0633\u0637 \u0627\u06CC\u0646 \u0633\u0637\u062D \u0648\u062C\u0648\u062F
    \u0646\u062F\u0627\u0631\u062F.\r\n\r\n<color=yellow>\u0646\u0645\u0627\u06CC
    \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644:</color>\n\u2022 \u0646\u0645\u0627\u06CC
    \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644 \u062A\u0648\u0633\u0637 \u0634\u06CC\u0627\u0631
    \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644 \u0628\u0647 \u062F\u0648 \u0642\u0633\u0645\u062A
    \u0646\u0633\u0628\u062A\u0627 \u0645\u0633\u0627\u0648\u06CC \u062A\u0642\u0633\u06CC\u0645
    \u0634\u062F\u0647 \u0627\u0633\u062A.\r\n\u2022 H.OFC \u062F\u0631 1/3 \u0648\u0633\u0637
    \u0627\u0633\u062A.\r\n\r\n<color=yellow>\u0646\u0645\u0627\u06CC \u0645\u0632\u06CC\u0627\u0644:</color>\n\u2022
    H.OFC \u062F\u0631 \u062D\u062F \u0627\u062A\u0635\u0627\u0644 1/3 \u0648\u0633\u0637
    \u0648 1/3 \u0627\u06A9\u0644\u0648\u0632\u0627\u0644 \u0627\u0633\u062A.\r\n\r\n<color=yellow>\u0646\u0645\u0627\u06CC
    \u0627\u06A9\u0644\u0648\u0632\u0627\u0644:</color>\n\u2022 \u0645\u06CC\u0632
    \u0627\u06A9\u0644\u0648\u0632\u0627\u0644 \u0645\u0633\u062A\u0637\u06CC\u0644
    \u0634\u06A9\u0644 \u0627\u0633\u062A.\r\n\u2022 4 \u06A9\u0627\u0633\u067E \u062F\u0631
    \u0627\u06CC\u0646 \u0646\u0645\u0627 \u062F\u06CC\u062F\u0647 \u0645\u06CC\u0634\u0648\u062F
    \u06A9 \u0645\u0639\u0645\u0648\u0644\u0627 \u06A9\u0627\u0633\u067E \u0645\u0632\u06CC\u0648
    \u0628\u0627\u06A9\u0627\u0644 \u0628\u0632\u0631\u06AF\u062A\u0631\u06CC\u0646
    \u0648 \u06A9\u0627\u0633\u067E \u062F\u06CC\u0633\u062A\u0648 \u0644\u06CC\u0646\u06AF\u0648\u0627\u0644
    \u0627\u0632 \u0647\u0645\u0647 \u06A9\u0648\u0686\u06A9 \u062A\u0631 \u0627\u0633\u062A.\r\n\u2022
    \u062F\u0648 \u0631\u06CC\u062C \u0639\u0631\u0636\u06CC \u062F\u0631 \u0627\u06CC\u0646
    \u062F\u0646\u062F\u0627\u0646 \u062F\u06CC\u062F\u0647 \u0645\u06CC\u0634\u0648\u062F.\r\n\u2022
